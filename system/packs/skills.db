{"_id":"4fdd2e8016b040c3","name":"Kampfkunst: Aikido","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_aikido","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 2, SK 4 | Stufe 2: Springen 4, Reaktion 4 | Stufe 3: Nahkampf 5, GE 4","description":"<p>Stufe 1: Parade mit Nahkampf. Stufe 2: Immer abrollen (-15 Sturzschaden). Stufe 3: Erfolgreiche Parade trifft Angreifer automatisch in Höhe des Überschusses.</p>"},"effects":[],"folder":"aaa8bd0bb8946a2a","sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"},"_key":"!items!4fdd2e8016b040c3"}
{"_id":"72a45808571a7962","name":"Kampfkunst: Boxen","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_boxen","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 2, Ausdauer 3, ST 3 | Stufe 2: Nahkampf 3, SK 3, GE 3 | Stufe 3: Nahkampf 4, SK 4, ST 4","description":"<p>Stufe 1: +1W6 Angriff mit Fäusten, Angriff umleiten auf Brust (TZ 6, 8) ohne Schaden. Stufe 2: +2W6 Ausweichen gegen Brusttreffer, +1W6 Faustschaden. Stufe 3: Kopf (12) & Bauch (7) ohne Zielmalus + Doppeltreffer.</p>"},"effects":[],"folder":"aaa8bd0bb8946a2a","sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"},"_key":"!items!72a45808571a7962"}
{"_id":"55ec81745dfeb19e","name":"Kampfkunst: Capoeira","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_capoeira","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Akrobatik 3, GE 3 | Stufe 2: Akrobatik 4, Nahkampf 3, ST 3 | Stufe 3: Akrobatik 5, Nahkampf 4, ST 3","description":"<p>Stufe 1: +1W6 Ausweichen im Nahkampf, kein Nachteil gegen Griffe. Stufe 2: +2W6 Schaden mit Beinen. Stufe 3: +1W6 Angriff mit Beinen, Gegner erleidet Kampfnachteil bei Verteidigung.</p>"},"effects":[],"folder":"aaa8bd0bb8946a2a","sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"},"_key":"!items!55ec81745dfeb19e"}
{"_id":"8c12473e984ff81e","name":"Kampfkunst: Escrima","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_escrima","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 2, Waffenkampf 2, SK 3, WA 3 | Stufe 2: NK/WK 3, GE 4, WI 3 | Stufe 3: NK/WK 4, Beidhändigkeit","description":"<p>Stufe 1: Parade mit Nahkampf oder Waffenkampf. Stufe 2: Freie Wahl zwischen Nahkampf und Waffenkampf. Stufe 3: Gleichzeitige Parade und Angriff ohne Malus für multiple Angriffe.</p>"},"effects":[],"folder":"aaa8bd0bb8946a2a","sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"},"_key":"!items!8c12473e984ff81e"}
{"_id":"469e93c53ec17496","name":"Kampfkunst: Jiu Jitsu","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_jiu_jitsu","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 2, GE 3, WA 3 | Stufe 2: Nahkampf 3, SK 4 | Stufe 3: Nahkampf 4, ST 4","description":"<p>Stufe 1: Parade mit Nahkampf. Stufe 2: +2W6 auf Ausweichen im Nahkampf. Stufe 3: +1W6 Angriff und +1W6 Schaden.</p>"},"effects":[],"folder":"aaa8bd0bb8946a2a","sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"},"_key":"!items!469e93c53ec17496"}
{"_id":"56b9a0f833ba97b1","name":"Kampfkunst: Karate","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_karate","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 2, SK 3 | Stufe 2: Nahkampf 3, KO 4 | Stufe 3: Nahkampf 5, ST 4","description":"<p>Stufe 1: Parade mit Nahkampf. Stufe 2: +2W6 Angriffsbonus. Stufe 3: +3W6 Schadensbonus.</p>"},"effects":[],"folder":"aaa8bd0bb8946a2a","sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"},"_key":"!items!56b9a0f833ba97b1"}
{"_id":"227514dc00c19022","name":"Kampfkunst: Kenjutsu","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_kenjutsu","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Waffenkampf 3, SK 4 | Stufe 2: Waffenkampf 3, GE 4 | Stufe 3: Waffenkampf 4, Beidhändigkeit","description":"<p>Stufe 1: Schwert ziehen und angreifen in einer Aktion. Stufe 2: +2W6 auf Angriffe und Paraden mit Klingenwaffen. Stufe 3: Gleichzeitige Parade und Gegenangriff.</p>"},"effects":[],"folder":"aaa8bd0bb8946a2a","sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"},"_key":"!items!227514dc00c19022"}
{"_id":"3f4eea9b2d795c3f","name":"Kampfkunst: Kick-Boxen","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_kick_boxen","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Ausdauer 2, Nahkampf 2, ST 3 | Stufe 2: Nahkampf 3, KO 4 | Stufe 3: Nahkampf 4, TO 5","description":"<p>Stufe 1: Angriff umleiten auf Brust (TZ 6, 8) + 1W6 KO bei Treffern auf Zone 4 & 10. Stufe 2: +2W6 Schaden mit Fäusten/Beinen. Stufe 3: +1W6 KO gegen alle Nahkampftreffer.</p>"},"effects":[],"folder":"aaa8bd0bb8946a2a","sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"},"_key":"!items!3f4eea9b2d795c3f"}
{"_id":"300717a35c7c4658","name":"Kampfkunst: Krav Maga","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_krav_maga","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 1, GE 3, ST 3 | Stufe 2: Nahkampf 2, WA 3 | Stufe 3: Nahkampf 3, SK 3","description":"<p>Stufe 1: Parade mit Nahkampf. Stufe 2: Tritt auf Becken/Genitalien ohne Zielmalus. Stufe 3: Kombinierter Angriff (Schaden + automatischer Clinch).</p>"},"effects":[],"folder":"aaa8bd0bb8946a2a","sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"},"_key":"!items!300717a35c7c4658"}
{"_id":"ea5e53ce76b190cd","name":"Kampfkunst: Muay Thai","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_muay_thai","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 3, SK 4 | Stufe 2: Akrobatik 2, GE 3, ST 3 | Stufe 3: Nahkampf 5, KO 4","description":"<p>Stufe 1: Kombinierter Angriff (Schaden + Clinch). Stufe 2: Zonen 6, 7, 8 ohne Zielmalus + 1W6 Schaden. Stufe 3: Gegenangriff stoppt Gegner bereits bei einfachem Übertreffen des Angriffswurfs.</p>"},"effects":[],"folder":"aaa8bd0bb8946a2a","sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"},"_key":"!items!ea5e53ce76b190cd"}
{"_id":"b8efb76ccccb9d5e","name":"Kampfkunst: Ringen","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_ringen","attribute":"staerke","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 3, ST 3 | Stufe 2: Nahkampf 4, GE 3 | Stufe 3: Nahkampf 5, GE 4, ST 4","description":"<p>Stufe 1: Gegner erleidet Kampfnachteil gegen Greifen. Stufe 2: +2W6 Stärke im Clinch. Stufe 3: Fixierungen ohne Kampfnachteil + 2W6 Schaden im Clinch.</p>"},"effects":[],"folder":"aaa8bd0bb8946a2a","sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"},"_key":"!items!b8efb76ccccb9d5e"}
{"_id":"897e2282307116c4","name":"Kampfkunst: Tae-Kwon-Do","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_tae_kwon_do","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Akrobatik 2, Nahkampf 3, SK 3 | Stufe 2: Akrobatik 3, Nahkampf 4, GE 4 | Stufe 3: Akrobatik 4, ST 4, SK 4","description":"<p>Stufe 1: +2W6 Angriff mit Beinen, Zonen ab Bauch abwärts ohne Zielmalus. Stufe 2: +1W6 Beinschaden, alle Zonen ohne Zielmalus. Stufe 3: Beinangriff erzielt automatisch zwei Treffer.</p>"},"effects":[],"folder":"aaa8bd0bb8946a2a","sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"},"_key":"!items!897e2282307116c4"}
{"_id":"5543161fe99c58d4","_key":"!items!5543161fe99c58d4","name":"Abenteuerlustig","type":"trait","img":"icons/sundries/Flags/banner-symbol-sun-gold-red.webp","folder":"4cbc3b9949f0850e","system":{"traitId":"trait_abenteuerlustig","traitType":"justice","cost":10,"costCurrency":"JP","opposingTrait":"","passiveModifiers":"Rollenspiel- & Situationsbonus gemäß GRW","skillModifiers":"","attributeModifiers":{"geschick":0,"staerke":0,"konstitution":0,"schnelligkeit":0,"wissen":0,"wahrnehmung":0,"charisma":0,"logik":0,"fahrzeuge":0,"schmerztoleranz":0,"adrenalin":0},"description":"<p><strong>Positives Charaktermerkmal (+10 JP):</strong> Der Charakter liebt das Risiko und neue Herausforderungen. Er stürzt sich voller Neugier in unbekannte Ruinen, Gefahrenzonen und Expeditionen.</p>"},"effects":[],"flags":{}}
{"_id":"792064b1fa570aae","_key":"!items!792064b1fa570aae","name":"Adrett","type":"trait","img":"icons/sundries/Flags/banner-symbol-sun-gold-red.webp","folder":"4cbc3b9949f0850e","system":{"traitId":"trait_adrett","traitType":"justice","cost":20,"costCurrency":"JP","opposingTrait":"","passiveModifiers":"Fertigkeitsbonus: ueberreden:+1, verhandeln:+1","skillModifiers":"ueberreden:+1, verhandeln:+1","attributeModifiers":{"geschick":0,"staerke":0,"konstitution":0,"schnelligkeit":0,"wissen":0,"wahrnehmung":0,"charisma":0,"logik":0,"fahrzeuge":0,"schmerztoleranz":0,"adrenalin":0},"description":"<p><strong>Positives Charaktermerkmal (+20 JP):</strong> Der Charakter achtet selbst im Ödland penibel auf sein Äußeres und ein gepflegtes Auftreten. Er erhält +1W auf soziale Interaktionen, sofern er sauber und gepflegt auftritt.</p>"},"effects":[],"flags":{}}
{"_id":"bcdfe3b975544dee","_key":"!items!bcdfe3b975544dee","name":"Akribisch","type":"trait","img":"icons/sundries/Flags/banner-symbol-sun-gold-red.webp","folder":"4cbc3b9949f0850e","system":{"traitId":"trait_akribisch","traitType":"justice","cost":10,"costCurrency":"JP","opposingTrait":"","passiveModifiers":"Rollenspiel- & Situationsbonus gemäß GRW","skillModifiers":"","attributeModifiers":{"geschick":0,"staerke":0,"konstitution":0,"schnelligkeit":0,"wissen":0,"wahrnehmung":0,"charisma":0,"logik":0,"fahrzeuge":0,"schmerztoleranz":0,"adrenalin":0},"description":"<p><strong>Positives Charaktermerkmal (+10 JP):</strong> Der Charakter arbeitet äußerst gewissenhaft, detailverliebt und gründlich und lässt keine Schlamperei durchgehen.</p>"},"effects":[],"flags":{}}
{"_id":"f9ffad231f29f18f","_key":"!items!f9ffad231f29f18f","name":"Albern","type":"trait","img":"icons/sundries/Flags/banner-symbol-sun-gold-red.webp","folder":"4cbc3b9949f0850e","system":{"traitId":"trait_albern","traitType":"justice","cost":20,"costCurrency":"JP","opposingTrait":"","passiveModifiers":"Rollenspiel- & Situationsbonus gemäß GRW","skillModifiers":"","attributeModifiers":{"geschick":0,"staerke":0,"konstitution":0,"schnelligkeit":0,"wissen":0,"wahrnehmung":0,"charisma":0,"logik":0,"fahrzeuge":0,"schmerztoleranz":0,"adrenalin":0},"description":"<p><strong>Positives Charaktermerkmal (+20 JP):</strong> Der Charakter nimmt selbst den Untergang der Welt mit Humor und heitert seine Gefährten mit Späßen und Witzen auf.</p>"},"effects":[],"flags":{}}
{"_id":"c376e75f097904b9","_key":"!items!c376e75f097904b9","name":"Analytisch","type":"trait","img":"icons/sundries/Flags/banner-symbol-sun-gold-red.webp","folder":"4cbc3b9949f0850e","system":{"traitId":"trait_analytisch","traitType":"justice","cost":10,"costCurrency":"JP","opposingTrait":"","passiveModifiers":"Rollenspiel- & Situationsbonus gemäß GRW","skillModifiers":"","attributeModifiers":{"geschick":0,"staerke":0,"konstitution":0,"schnelligkeit":0,"wissen":0,"wahrnehmung":0,"charisma":0,"logik":0,"fahrzeuge":0,"schmerztoleranz":0,"adrenalin":0},"description":"<p><strong>Positives Charaktermerkmal (+10 JP):</strong> Der Charakter zerlegt Probleme nüchtern und logisch in ihre Einzelteile, bevor er handelt.</p>"},"effects":[],"flags":{}}
