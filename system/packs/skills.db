{"_id":"b281046bc5c5ebf6","_key":"!items!b281046bc5c5ebf6","name":"Kampfkunst: Krav Maga","type":"skill","img":"icons/svg/book.svg","folder":"NRfldSkilStandar","sort":9400,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Standardfertigkeiten","folderId":"NRfldSkilStandar"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"skillId":"kk_krav_maga","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 1, GE 3, ST 3 | Stufe 2: Nahkampf 2, WA 3 | Stufe 3: Nahkampf 3, SK 3","description":"<p>Stufe 1: Parade mit Nahkampf. Stufe 2: Tritt auf Becken/Genitalien ohne Zielmalus. Stufe 3: Kombinierter Angriff (Schaden + automatischer Clinch).</p>"}}
{"_id":"e0e65d417875fd71","_key":"!items!e0e65d417875fd71","name":"Kampfkunst: Muay Thai","type":"skill","img":"icons/svg/book.svg","folder":"NRfldSkilStandar","sort":9500,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Standardfertigkeiten","folderId":"NRfldSkilStandar"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"skillId":"kk_muay_thai","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 3, SK 4 | Stufe 2: Akrobatik 2, GE 3, ST 3 | Stufe 3: Nahkampf 5, KO 4","description":"<p>Stufe 1: Kombinierter Angriff (Schaden + Clinch). Stufe 2: Zonen 6, 7, 8 ohne Zielmalus + 1W6 Schaden. Stufe 3: Gegenangriff stoppt Gegner bereits bei einfachem Übertreffen des Angriffswurfs.</p>"}}
{"_id":"7230d9c529897e98","_key":"!items!7230d9c529897e98","name":"Kampfkunst: Ringen","type":"skill","img":"icons/svg/book.svg","folder":"NRfldSkilStandar","sort":9600,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Standardfertigkeiten","folderId":"NRfldSkilStandar"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"skillId":"kk_ringen","attribute":"staerke","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 3, ST 3 | Stufe 2: Nahkampf 4, GE 3 | Stufe 3: Nahkampf 5, GE 4, ST 4","description":"<p>Stufe 1: Gegner erleidet Kampfnachteil gegen Greifen. Stufe 2: +2W6 Stärke im Clinch. Stufe 3: Fixierungen ohne Kampfnachteil + 2W6 Schaden im Clinch.</p>"}}
{"_id":"41c44451c4ab2393","_key":"!items!41c44451c4ab2393","name":"Kampfkunst: Tae-Kwon-Do","type":"skill","img":"icons/svg/book.svg","folder":"NRfldSkilStandar","sort":9700,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Standardfertigkeiten","folderId":"NRfldSkilStandar"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"skillId":"kk_tae_kwon_do","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Akrobatik 2, Nahkampf 3, SK 3 | Stufe 2: Akrobatik 3, Nahkampf 4, GE 4 | Stufe 3: Akrobatik 4, ST 4, SK 4","description":"<p>Stufe 1: +2W6 Angriff mit Beinen, Zonen ab Bauch abwärts ohne Zielmalus. Stufe 2: +1W6 Beinschaden, alle Zonen ohne Zielmalus. Stufe 3: Beinangriff erzielt automatisch zwei Treffer.</p>"}}
{"_id":"9928881020d98244","_key":"!items!9928881020d98244","name":"Abenteuerlustig","type":"trait","img":"icons/sundries/Flags/banner-symbol-sun-gold-red.webp","folder":"NRfldSkilMerkmal","sort":9800,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Charaktermerkmale (Vor- & Nachteile)","folderId":"NRfldSkilMerkmal"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"traitId":"trait_abenteuerlustig","traitType":"justice","cost":10,"costCurrency":"JP","opposingTrait":"","passiveModifiers":"Rollenspiel- & Situationsbonus gemäß GRW","skillModifiers":"","attributeModifiers":{"geschick":0,"staerke":0,"konstitution":0,"schnelligkeit":0,"wissen":0,"wahrnehmung":0,"charisma":0,"logik":0,"fahrzeuge":0,"schmerztoleranz":0,"adrenalin":0},"description":"<p><strong>Positives Charaktermerkmal (+10 JP):</strong> Der Charakter liebt das Risiko und neue Herausforderungen. Er stürzt sich voller Neugier in unbekannte Ruinen, Gefahrenzonen und Expeditionen.</p>"}}
{"_id":"ec917f97d8c89372","_key":"!items!ec917f97d8c89372","name":"Adrett","type":"trait","img":"icons/sundries/Flags/banner-symbol-sun-gold-red.webp","folder":"NRfldSkilMerkmal","sort":9900,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Charaktermerkmale (Vor- & Nachteile)","folderId":"NRfldSkilMerkmal"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"traitId":"trait_adrett","traitType":"justice","cost":20,"costCurrency":"JP","opposingTrait":"","passiveModifiers":"Fertigkeitsbonus: ueberreden:+1, verhandeln:+1","skillModifiers":"ueberreden:+1, verhandeln:+1","attributeModifiers":{"geschick":0,"staerke":0,"konstitution":0,"schnelligkeit":0,"wissen":0,"wahrnehmung":0,"charisma":0,"logik":0,"fahrzeuge":0,"schmerztoleranz":0,"adrenalin":0},"description":"<p><strong>Positives Charaktermerkmal (+20 JP):</strong> Der Charakter achtet selbst im Ödland penibel auf sein Äußeres und ein gepflegtes Auftreten. Er erhält +1W auf soziale Interaktionen, sofern er sauber und gepflegt auftritt.</p>"}}
