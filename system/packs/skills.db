{"_id":"4fdd2e8016b040c3","name":"Kampfkunst: Aikido","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_aikido","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 2, SK 4 | Stufe 2: Springen 4, Reaktion 4 | Stufe 3: Nahkampf 5, GE 4","description":"<p>Stufe 1: Parade mit Nahkampf. Stufe 2: Immer abrollen (-15 Sturzschaden). Stufe 3: Erfolgreiche Parade trifft Angreifer automatisch in Höhe des Überschusses.</p>"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"}}
{"_id":"72a45808571a7962","name":"Kampfkunst: Boxen","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_boxen","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 2, Ausdauer 3, ST 3 | Stufe 2: Nahkampf 3, SK 3, GE 3 | Stufe 3: Nahkampf 4, SK 4, ST 4","description":"<p>Stufe 1: +1W6 Angriff mit Fäusten, Angriff umleiten auf Brust (TZ 6, 8) ohne Schaden. Stufe 2: +2W6 Ausweichen gegen Brusttreffer, +1W6 Faustschaden. Stufe 3: Kopf (12) & Bauch (7) ohne Zielmalus + Doppeltreffer.</p>"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"}}
{"_id":"55ec81745dfeb19e","name":"Kampfkunst: Capoeira","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_capoeira","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Akrobatik 3, GE 3 | Stufe 2: Akrobatik 4, Nahkampf 3, ST 3 | Stufe 3: Akrobatik 5, Nahkampf 4, ST 3","description":"<p>Stufe 1: +1W6 Ausweichen im Nahkampf, kein Nachteil gegen Griffe. Stufe 2: +2W6 Schaden mit Beinen. Stufe 3: +1W6 Angriff mit Beinen, Gegner erleidet Kampfnachteil bei Verteidigung.</p>"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"}}
{"_id":"8c12473e984ff81e","name":"Kampfkunst: Escrima","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_escrima","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 2, Waffenkampf 2, SK 3, WA 3 | Stufe 2: NK/WK 3, GE 4, WI 3 | Stufe 3: NK/WK 4, Beidhändigkeit","description":"<p>Stufe 1: Parade mit Nahkampf oder Waffenkampf. Stufe 2: Freie Wahl zwischen Nahkampf und Waffenkampf. Stufe 3: Gleichzeitige Parade und Angriff ohne Malus für multiple Angriffe.</p>"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"}}
{"_id":"469e93c53ec17496","name":"Kampfkunst: Jiu Jitsu","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_jiu_jitsu","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 2, GE 3, WA 3 | Stufe 2: Nahkampf 3, SK 4 | Stufe 3: Nahkampf 4, ST 4","description":"<p>Stufe 1: Parade mit Nahkampf. Stufe 2: +2W6 auf Ausweichen im Nahkampf. Stufe 3: +1W6 Angriff und +1W6 Schaden.</p>"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"}}
{"_id":"56b9a0f833ba97b1","name":"Kampfkunst: Karate","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_karate","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 2, SK 3 | Stufe 2: Nahkampf 3, KO 4 | Stufe 3: Nahkampf 5, ST 4","description":"<p>Stufe 1: Parade mit Nahkampf. Stufe 2: +2W6 Angriffsbonus. Stufe 3: +3W6 Schadensbonus.</p>"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"}}
{"_id":"227514dc00c19022","name":"Kampfkunst: Kenjutsu","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_kenjutsu","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Waffenkampf 3, SK 4 | Stufe 2: Waffenkampf 3, GE 4 | Stufe 3: Waffenkampf 4, Beidhändigkeit","description":"<p>Stufe 1: Schwert ziehen und angreifen in einer Aktion. Stufe 2: +2W6 auf Angriffe und Paraden mit Klingenwaffen. Stufe 3: Gleichzeitige Parade und Gegenangriff.</p>"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"}}
{"_id":"3f4eea9b2d795c3f","name":"Kampfkunst: Kick-Boxen","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_kick_boxen","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Ausdauer 2, Nahkampf 2, ST 3 | Stufe 2: Nahkampf 3, KO 4 | Stufe 3: Nahkampf 4, TO 5","description":"<p>Stufe 1: Angriff umleiten auf Brust (TZ 6, 8) + 1W6 KO bei Treffern auf Zone 4 & 10. Stufe 2: +2W6 Schaden mit Fäusten/Beinen. Stufe 3: +1W6 KO gegen alle Nahkampftreffer.</p>"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"}}
{"_id":"300717a35c7c4658","name":"Kampfkunst: Krav Maga","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_krav_maga","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 1, GE 3, ST 3 | Stufe 2: Nahkampf 2, WA 3 | Stufe 3: Nahkampf 3, SK 3","description":"<p>Stufe 1: Parade mit Nahkampf. Stufe 2: Tritt auf Becken/Genitalien ohne Zielmalus. Stufe 3: Kombinierter Angriff (Schaden + automatischer Clinch).</p>"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"}}
{"_id":"ea5e53ce76b190cd","name":"Kampfkunst: Muay Thai","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_muay_thai","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 3, SK 4 | Stufe 2: Akrobatik 2, GE 3, ST 3 | Stufe 3: Nahkampf 5, KO 4","description":"<p>Stufe 1: Kombinierter Angriff (Schaden + Clinch). Stufe 2: Zonen 6, 7, 8 ohne Zielmalus + 1W6 Schaden. Stufe 3: Gegenangriff stoppt Gegner bereits bei einfachem Übertreffen des Angriffswurfs.</p>"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"}}
{"_id":"b8efb76ccccb9d5e","name":"Kampfkunst: Ringen","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_ringen","attribute":"staerke","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Nahkampf 3, ST 3 | Stufe 2: Nahkampf 4, GE 3 | Stufe 3: Nahkampf 5, GE 4, ST 4","description":"<p>Stufe 1: Gegner erleidet Kampfnachteil gegen Greifen. Stufe 2: +2W6 Stärke im Clinch. Stufe 3: Fixierungen ohne Kampfnachteil + 2W6 Schaden im Clinch.</p>"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"}}
{"_id":"897e2282307116c4","name":"Kampfkunst: Tae-Kwon-Do","type":"skill","img":"icons/svg/book.svg","system":{"skillId":"kk_tae_kwon_do","attribute":"geschick","category":"kampfkunst","zoneReference":"OA","level":1,"mod":0,"betaBio":false,"unskilledAllowed":false,"costGp":5,"costEpFormula":"10","prerequisites":"Stufe 1: Akrobatik 2, Nahkampf 3, SK 3 | Stufe 2: Akrobatik 3, Nahkampf 4, GE 4 | Stufe 3: Akrobatik 4, ST 4, SK 4","description":"<p>Stufe 1: +2W6 Angriff mit Beinen, Zonen ab Bauch abwärts ohne Zielmalus. Stufe 2: +1W6 Beinschaden, alle Zonen ohne Zielmalus. Stufe 3: Beinangriff erzielt automatisch zwei Treffer.</p>"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.0.0","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"a15088359d671ae9"}}
