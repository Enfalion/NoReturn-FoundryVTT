{"_id":"e8a72dd945b1a888","_key":"!items!e8a72dd945b1a888","name":"Fleischrost","type":"disease","img":"icons/magic/acid/dissolve-bone-skull.webp","folder":"NRfldSkilKrankTo","sort":15200,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Krankheiten & Toxine","folderId":"NRfldSkilKrankTo"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"conditionId":"cond_fleischrost","conditionType":"krankheit","incubationTime":"1–2 Stunden","testInterval":"Alle 48 Stunden","resistanceFormula":"@status.infektionsresistenz","intensity":4,"identificationMw":10,"currentStage":1,"symptomStages":"Grad I: Erste Hautverfärbungen und Nekrosen (9 TP permanenter Schaden auf betroffene Trefferzone). Grad II: Fortschreitender Gewebezerfall (18 TP permanenter Schaden auf betroffene Trefferzone). Grad III: Komplette Verrostung und Absterben der Trefferzone (Verlust der Gliedmaße oder Tod bei Rumpf/Kopf).","damagePerStage":"9 TP (Grad I) / 18 TP (Grad II) / TZ-Verlust (Grad III)","penaltiesPerStage":"-1W auf alle körperlichen Proben pro Krankheitsgrad","antidote":"Kombination aus Bemustarol + Ergobormin (Medizin MW 10)","transmission":"Tröpfchen-, Blut- oder Kontaktinfektion","description":"<p><strong>Fleischrost (Intensität 4):</strong> Eine gefürchtete bakterielle Nekrose der Todeszonen, die Gewebe rostbraun verfärbt und zersetzt. Ohne rechtzeitige Behandlung mit Bemustarol und Ergobormin stirbt die betroffene Trefferzone vollständig ab.</p>"}}
{"_id":"23146336b8e922a6","_key":"!items!23146336b8e922a6","name":"Flugnekrose","type":"disease","img":"icons/magic/death/skull-poison-green.webp","folder":"NRfldSkilKrankTo","sort":15300,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Krankheiten & Toxine","folderId":"NRfldSkilKrankTo"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"conditionId":"cond_flugnekrose","conditionType":"krankheit","incubationTime":"5 Tage","testInterval":"Alle 24 Stunden","resistanceFormula":"@status.infektionsresistenz","intensity":6,"identificationMw":15,"currentStage":1,"symptomStages":"Stadium I (Frühphase, Intensität 3, Medizin MW 15): Fieber, blutiger Husten, 1W6 Organismusverlust pro Tag. Stadium II (Akutphase, Intensität 6, Medizin MW 20): Schwarze Hautflecken, Lungenbluten, 1W6 Organismusverlust pro Tag. Stadium III: Organversagen bei Organismus 0.","damagePerStage":"1W6 Organismusverlust pro Tag","penaltiesPerStage":"-1W auf Ausdauer und Konstitution pro Stadium","antidote":"Neo-Penecillin (Medizin MW 15 bzw. MW 20 im fortgeschrittenen Stadium)","transmission":"Tröpfchen-, Blut- oder Kontaktinfektion","description":"<p><strong>Flugnekrose (Intensität 3 / 6):</strong> Über Sporen und Staub übertragene Seuche, die schleichend die inneren Organe zersetzt und täglich 1W6 Punkte Organismus kostet.</p>"}}
{"_id":"9fba2368f3303c3c","_key":"!items!9fba2368f3303c3c","name":"Nemo-Virus","type":"disease","img":"icons/magic/unholy/orb-glowing-purple.webp","folder":"NRfldSkilKrankTo","sort":15400,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Krankheiten & Toxine","folderId":"NRfldSkilKrankTo"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"conditionId":"cond_nemo_virus","conditionType":"krankheit","incubationTime":"1–2 Stunden","testInterval":"Alle 6 Stunden (tödlich nach 24 Stunden)","resistanceFormula":"@status.infektionsresistenz","intensity":9,"identificationMw":15,"currentStage":1,"symptomStages":"Stadium I (nach 2h): Schüttelfrost, Blutungen aus Schleimhäuten (-2W auf alle Proben). Stadium II (nach 12h): Beginnende Verflüssigung der inneren Organe (2W6 Direktschaden auf Rumpf, Bewusstlosigkeit). Stadium III (nach 24h): Vollständige Organverflüssigung und Tod.","damagePerStage":"2W6 Direktschaden / Tod nach 24h","penaltiesPerStage":"-2W auf alle Proben ab Stadium I","antidote":"Kein bekanntes Gegenmittel (nur symptomatische Eindämmung oder Quarantäne)","transmission":"Tröpfchen-, Blut- oder Kontaktinfektion","description":"<p><strong>Nemo-Virus (Intensität 9):</strong> Hochtödlicher Biokampfstoff aus der Zeit des großen Krieges. Führt binnen 24 Stunden zur Verflüssigung der inneren Organe.</p>"}}
{"_id":"1ff5f5c2075ddeb9","_key":"!items!1ff5f5c2075ddeb9","name":"Pandora-Effekt","type":"disease","img":"icons/magic/death/undead-skeleton-grave-green.webp","folder":"NRfldSkilKrankTo","sort":15500,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Krankheiten & Toxine","folderId":"NRfldSkilKrankTo"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"conditionId":"cond_pandora_effekt","conditionType":"krankheit","incubationTime":"45 Minuten","testInterval":"Einmalig nach 45 Minuten","resistanceFormula":"@status.infektionsresistenz","intensity":7,"identificationMw":10,"currentStage":1,"symptomStages":"Stadium I: Rasender Puls, schwarze Adern und Delirium. Stadium II: Herzstillstand nach 45 Minuten bei misslungener Widerstandsprobe. Stadium III: Reanimation als hirnloser, aggressiver Zombie durch den mutierten HMO-Virus unter Strahlungseinfluss.","damagePerStage":"Tod und Verwandlung in einen Zombie bei Fehlschlag","penaltiesPerStage":"-2W auf Geistige Proben während der Inkubation","antidote":"Kein Gegenmittel (sofortige Amputation der Bissstelle innerhalb von 5 Minuten möglich)","transmission":"Tröpfchen-, Blut- oder Kontaktinfektion","description":"<p><strong>Pandora-Effekt (Intensität 7):</strong> Eine durch radioaktive Strahlung mutierte Variante des HMO-Virus. Verwandelt Infizierte binnen 45 Minuten in untote Zombies.</p>"}}
{"_id":"6983fcf917cf5534","_key":"!items!6983fcf917cf5534","name":"SMF-V (Sub-Mutagener-Fresszellen-Virus)","type":"disease","img":"icons/creatures/abilities/mouth-teeth-long-red.webp","folder":"NRfldSkilKrankTo","sort":15600,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Krankheiten & Toxine","folderId":"NRfldSkilKrankTo"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"conditionId":"cond_smf_v_sub_mutagener_fresszellen_virus_","conditionType":"krankheit","incubationTime":"4–8 Tage (KO × 2 Tage bis zur vollständigen Mutation)","testInterval":"Alle 24 Stunden","resistanceFormula":"@status.infektionsresistenz","intensity":10,"identificationMw":20,"currentStage":1,"symptomStages":"Stadium I (ab 3h): Scharfe Zähne wachsen, unstillbarer Hunger auf rohes Fleisch (-5 Psyche und -5 Organismus pro Tag). Stadium II (ab 6h): Krallen brechen aus den Fingern, Haarausfall, zunehmender Kontrollverlust. Stadium III (bei Psyche/Organismus 0): Vollständige Verwandlung in einen blutrünstigen Cardo.","damagePerStage":"-5 Psyche und -5 Organismus pro Tag","penaltiesPerStage":"Kontrollverlust bei Blutgeruch (Willenskraft gegen Intensität 10)","antidote":"Kein bekanntes Heilmittel","transmission":"Tröpfchen-, Blut- oder Kontaktinfektion","description":"<p><strong>SMF-V (Intensität 10):</strong> Der Sub-Mutagene-Fresszellen-Virus wird durch den Biss oder Speichel von Cardos übertragen und formt das Opfer unaufhaltsam selbst in einen Cardo um.</p>"}}
{"_id":"a2aeb30e43bba118","_key":"!items!a2aeb30e43bba118","name":"Steincobra-Kontaktgift","type":"toxin","img":"icons/consumables/potions/bottle-conical-fumes-green.webp","folder":"NRfldSkilKrankTo","sort":15700,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Krankheiten & Toxine","folderId":"NRfldSkilKrankTo"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"conditionId":"cond_steincobra_kontaktgift","conditionType":"gift","incubationTime":"Sofort","testInterval":"Jede Kampfrunde (für 5 KR)","resistanceFormula":"@status.infektionsresistenz","intensity":9,"identificationMw":15,"currentStage":1,"symptomStages":"Wirkung über 5 Kampfrunden: Jede Kampfrunde 9 TP Giftschaden auf den Kopf (TZ 12) bei misslungener Widerstandsprobe gegen Intensität 9. Bei direktem Treffer in die Augen droht dauerhafte Erblindung.","damagePerStage":"9 TP pro Kampfrunde auf Kopf (TZ 12) für 5 KR","penaltiesPerStage":"Erblindung (-4W auf Sichtproben und Fernkampf)","antidote":"Antitoxin-Injektor oder sofortiges Ausspülen + Medizin MW 15","transmission":"Direkter Kontakt / Injektion","description":"<p><strong>Steincobra-Kontaktgift (Intensität 9):</strong> Hochätzendes Neuro- und Kontaktgift der Steincobra, das auf kurze Distanz in Gesicht und Augen gespieen wird.</p>"}}
{"_id":"f37d520f7b4e319a","_key":"!items!f37d520f7b4e319a","name":"Narkotisches Mutantengift","type":"toxin","img":"icons/consumables/potions/vial-cork-green.webp","folder":"NRfldSkilKrankTo","sort":15800,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Krankheiten & Toxine","folderId":"NRfldSkilKrankTo"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"conditionId":"cond_narkotisches_mutantengift","conditionType":"gift","incubationTime":"Sofort","testInterval":"Einmalig bei Injektion (Wirkungsdauer 20 KR)","resistanceFormula":"@status.infektionsresistenz","intensity":6,"identificationMw":12,"currentStage":1,"symptomStages":"Stadium I: Schwere Lähmungserscheinungen (-3W6 auf alle Attribute für 20 Kampfrunden). Stadium II: Sinkt die Konstitution dadurch auf 0 oder darunter, fällt das Opfer sofort in tiefe Bewusstlosigkeit.","damagePerStage":"Kein Direktschaden (Paralyse)","penaltiesPerStage":"-3W6 auf alle Attribute für 20 KR; Bewusstlosigkeit bei KO ≤ 0","antidote":"Adrenalin-Schockinjektor oder Antitoxin","transmission":"Direkter Kontakt / Injektion","description":"<p><strong>Narkotisches Gift (Intensität 6):</strong> Von mutierten Raubtieren und Giftdrüsen-Mutanten produziertes Lähmungsgift, das Opfer binnen Sekunden wehrlos macht.</p>"}}
{"_id":"9377a7ac0aeb5600","_key":"!items!9377a7ac0aeb5600","name":"Toxisches Mutantengift","type":"toxin","img":"icons/consumables/potions/potion-flask-corked-skull-poison-green.webp","folder":"NRfldSkilKrankTo","sort":15900,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Krankheiten & Toxine","folderId":"NRfldSkilKrankTo"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"conditionId":"cond_toxisches_mutantengift","conditionType":"gift","incubationTime":"Sofort","testInterval":"Jede Kampfrunde (für 3 KR)","resistanceFormula":"@status.infektionsresistenz","intensity":8,"identificationMw":15,"currentStage":1,"symptomStages":"Wirkung über 3 Kampfrunden: Verursacht jede Kampfrunde 6 TP Direktschaden (ignoriert Rüstung) auf Rumpf/Herz oder Kopf bei misslungener Widerstandsprobe gegen Intensität 8.","damagePerStage":"6 TP Direktschaden pro KR für 3 KR (Herz/Kopf)","penaltiesPerStage":"-1W auf alle Handlungen durch heftige Krämpfe","antidote":"Breitband-Antitoxin (Medizin MW 15)","transmission":"Direkter Kontakt / Injektion","description":"<p><strong>Toxisches Gift (Intensität 8):</strong> Tödliches Hämo- und Neurotoxin, das direkt das Herz-Kreislauf-System angreift.</p>"}}
{"_id":"aef3925a88190776","_key":"!items!aef3925a88190776","name":"Strahlungskrankheit (Akute Verstrahlung)","type":"disease","img":"icons/magic/light/explosion-star-glow-orange.webp","folder":"NRfldSkilKrankTo","sort":16000,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Krankheiten & Toxine","folderId":"NRfldSkilKrankTo"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"conditionId":"cond_strahlungskrankheit_akute_verstrahlung_","conditionType":"umwelt","incubationTime":"1–6 Stunden","testInterval":"Alle 24 Stunden","resistanceFormula":"@status.infektionsresistenz","intensity":6,"identificationMw":15,"currentStage":1,"symptomStages":"Grad I: Übelkeit, Kopfschmerzen, -1W6 Organismus. Grad II: Haarausfall, innere Blutungen, -2W6 Organismus und -1W auf alle körperlichen Proben. Grad III: Zellzerfall, -3W6 Organismus pro Tag bis zum Tod.","damagePerStage":"1W6 bis 3W6 Organismusverlust pro Tag","penaltiesPerStage":"-1W bis -3W auf Konstitutions- und Ausdauerproben","antidote":"Rad-Away / Dekontaminationsbehandlung + Jod-Stabilisatoren","transmission":"Direkter Kontakt / Injektion","description":"<p><strong>Strahlungskrankheit (Intensität 6):</strong> Folge längerer Aufenthalte in verstrahlten Kratern oder ohne Schutzanzug im Roten Nebel.</p>"}}
{"_id":"d882d99799ea6e02","_key":"!items!d882d99799ea6e02","name":"Säureverätzung (Saurer Regen / Ozean)","type":"toxin","img":"icons/magic/acid/projectile-smoke-glowing.webp","folder":"NRfldSkilKrankTo","sort":16100,"ownership":{"default":0},"flags":{"noreturn":{"folderName":"Krankheiten & Toxine","folderId":"NRfldSkilKrankTo"}},"_stats":{"compendiumSource":null,"duplicateSource":null,"coreVersion":"14.331","systemId":"noreturn","systemVersion":"1.1.1","createdTime":1730000000000,"modifiedTime":1730000000000,"lastModifiedBy":"ce448e9f408302b3"},"effects":[],"system":{"conditionId":"cond_s_urever_tzung_saurer_regen_ozean_","conditionType":"gift","incubationTime":"Sofort bei Kontakt","testInterval":"Jede Kampfrunde / Minute im Kontakt","resistanceFormula":"@status.infektionsresistenz","intensity":5,"identificationMw":10,"currentStage":1,"symptomStages":"Ungeschützter Kontakt mit saurem Regen oder dem vergifteten Ozean verursacht 10p. bis 20p. Ätz- und Hitzeschaden pro Kampfrunde auf alle ungeschützten Trefferzonen.","damagePerStage":"10–20p. Ätzschaden pro KR auf ungeschützte Zonen","penaltiesPerStage":"Schmerzabzüge und Beschädigung unversiegelter Rüstung","antidote":"Neutralisationslösung, Schutzkleidung oder sofortige Dekontamination mit sauberem Wasser","transmission":"Direkter Kontakt / Injektion","description":"<p><strong>Säureverätzung (Intensität 5):</strong> Die toxischen Wolken und sauren Meere von NoReturn zerfressen ungeschützte Haut und gewöhnliche Kleidung binnen Sekunden.</p>"}}
