{"_id":"95b83a414c128f37","_key":"!items!95b83a414c128f37","name":"Talent: Überlebenskünstler","type":"trait","img":"icons/environment/wilderness/camp-tent-brown.webp","folder":"4cbc3b9949f0850e","system":{"traitId":"trait_talent_berlebensk_nstler","traitType":"talent","cost":1,"costCurrency":"GP","opposingTrait":"","passiveModifiers":"Fertigkeitsbonus: orientierung:+1, spurenlesen:+1, ortskenntnis:+1","skillModifiers":"orientierung:+1, spurenlesen:+1, ortskenntnis:+1","attributeModifiers":{"geschick":0,"staerke":0,"konstitution":0,"schnelligkeit":0,"wissen":0,"wahrnehmung":0,"charisma":0,"logik":0,"fahrzeuge":0,"schmerztoleranz":0,"adrenalin":0},"description":"<p><strong>Talent (Charaktererschaffung):</strong> Ausgeprägter Instinkt für das Überleben in den Todeszonen (+1W auf Orientierung, Spurenlesen und Ortskenntnis).</p>"},"effects":[],"flags":{}}
{"_id":"efca5f17c57f32a9","_key":"!items!efca5f17c57f32a9","name":"Fleischrost","type":"condition","img":"icons/magic/acid/dissolve-bone-skull.webp","folder":"01b52ba4538f93a2","system":{"conditionId":"cond_fleischrost","conditionType":"krankheit","incubationTime":"1–2 Stunden","testInterval":"Alle 48 Stunden","resistanceFormula":"@status.infektionsresistenz","intensity":4,"identificationMw":10,"currentStage":1,"symptomStages":"Grad I: Erste Hautverfärbungen und Nekrosen (9 TP permanenter Schaden auf betroffene Trefferzone). Grad II: Fortschreitender Gewebezerfall (18 TP permanenter Schaden auf betroffene Trefferzone). Grad III: Komplette Verrostung und Absterben der Trefferzone (Verlust der Gliedmaße oder Tod bei Rumpf/Kopf).","damagePerStage":"9 TP (Grad I) / 18 TP (Grad II) / TZ-Verlust (Grad III)","penaltiesPerStage":"-1W auf alle körperlichen Proben pro Krankheitsgrad","antidote":"Kombination aus Bemustarol + Ergobormin (Medizin MW 10)","transmission":"Tröpfchen-, Blut- oder Kontaktinfektion","description":"<p><strong>Fleischrost (Intensität 4):</strong> Eine gefürchtete bakterielle Nekrose der Todeszonen, die Gewebe rostbraun verfärbt und zersetzt. Ohne rechtzeitige Behandlung mit Bemustarol und Ergobormin stirbt die betroffene Trefferzone vollständig ab.</p>"},"effects":[],"flags":{}}
{"_id":"c3685c51c1e89373","_key":"!items!c3685c51c1e89373","name":"Flugnekrose","type":"condition","img":"icons/magic/death/skull-poison-green.webp","folder":"01b52ba4538f93a2","system":{"conditionId":"cond_flugnekrose","conditionType":"krankheit","incubationTime":"5 Tage","testInterval":"Alle 24 Stunden","resistanceFormula":"@status.infektionsresistenz","intensity":6,"identificationMw":15,"currentStage":1,"symptomStages":"Stadium I (Frühphase, Intensität 3, Medizin MW 15): Fieber, blutiger Husten, 1W6 Organismusverlust pro Tag. Stadium II (Akutphase, Intensität 6, Medizin MW 20): Schwarze Hautflecken, Lungenbluten, 1W6 Organismusverlust pro Tag. Stadium III: Organversagen bei Organismus 0.","damagePerStage":"1W6 Organismusverlust pro Tag","penaltiesPerStage":"-1W auf Ausdauer und Konstitution pro Stadium","antidote":"Neo-Penecillin (Medizin MW 15 bzw. MW 20 im fortgeschrittenen Stadium)","transmission":"Tröpfchen-, Blut- oder Kontaktinfektion","description":"<p><strong>Flugnekrose (Intensität 3 / 6):</strong> Über Sporen und Staub übertragene Seuche, die schleichend die inneren Organe zersetzt und täglich 1W6 Punkte Organismus kostet.</p>"},"effects":[],"flags":{}}
{"_id":"44bc56b3dccf69e5","_key":"!items!44bc56b3dccf69e5","name":"Nemo-Virus","type":"condition","img":"icons/magic/unholy/orb-glowing-purple.webp","folder":"01b52ba4538f93a2","system":{"conditionId":"cond_nemo_virus","conditionType":"krankheit","incubationTime":"1–2 Stunden","testInterval":"Alle 6 Stunden (tödlich nach 24 Stunden)","resistanceFormula":"@status.infektionsresistenz","intensity":9,"identificationMw":15,"currentStage":1,"symptomStages":"Stadium I (nach 2h): Schüttelfrost, Blutungen aus Schleimhäuten (-2W auf alle Proben). Stadium II (nach 12h): Beginnende Verflüssigung der inneren Organe (2W6 Direktschaden auf Rumpf, Bewusstlosigkeit). Stadium III (nach 24h): Vollständige Organverflüssigung und Tod.","damagePerStage":"2W6 Direktschaden / Tod nach 24h","penaltiesPerStage":"-2W auf alle Proben ab Stadium I","antidote":"Kein bekanntes Gegenmittel (nur symptomatische Eindämmung oder Quarantäne)","transmission":"Tröpfchen-, Blut- oder Kontaktinfektion","description":"<p><strong>Nemo-Virus (Intensität 9):</strong> Hochtödlicher Biokampfstoff aus der Zeit des großen Krieges. Führt binnen 24 Stunden zur Verflüssigung der inneren Organe.</p>"},"effects":[],"flags":{}}
{"_id":"9f2bf5422bcf59ed","_key":"!items!9f2bf5422bcf59ed","name":"Pandora-Effekt","type":"condition","img":"icons/magic/death/undead-skeleton-grave-green.webp","folder":"01b52ba4538f93a2","system":{"conditionId":"cond_pandora_effekt","conditionType":"krankheit","incubationTime":"45 Minuten","testInterval":"Einmalig nach 45 Minuten","resistanceFormula":"@status.infektionsresistenz","intensity":7,"identificationMw":10,"currentStage":1,"symptomStages":"Stadium I: Rasender Puls, schwarze Adern und Delirium. Stadium II: Herzstillstand nach 45 Minuten bei misslungener Widerstandsprobe. Stadium III: Reanimation als hirnloser, aggressiver Zombie durch den mutierten HMO-Virus unter Strahlungseinfluss.","damagePerStage":"Tod und Verwandlung in einen Zombie bei Fehlschlag","penaltiesPerStage":"-2W auf Geistige Proben während der Inkubation","antidote":"Kein Gegenmittel (sofortige Amputation der Bissstelle innerhalb von 5 Minuten möglich)","transmission":"Tröpfchen-, Blut- oder Kontaktinfektion","description":"<p><strong>Pandora-Effekt (Intensität 7):</strong> Eine durch radioaktive Strahlung mutierte Variante des HMO-Virus. Verwandelt Infizierte binnen 45 Minuten in untote Zombies.</p>"},"effects":[],"flags":{}}
{"_id":"a03c179419590efc","_key":"!items!a03c179419590efc","name":"SMF-V (Sub-Mutagener-Fresszellen-Virus)","type":"condition","img":"icons/creatures/abilities/mouth-teeth-long-red.webp","folder":"01b52ba4538f93a2","system":{"conditionId":"cond_smf_v_sub_mutagener_fresszellen_virus_","conditionType":"krankheit","incubationTime":"4–8 Tage (KO × 2 Tage bis zur vollständigen Mutation)","testInterval":"Alle 24 Stunden","resistanceFormula":"@status.infektionsresistenz","intensity":10,"identificationMw":20,"currentStage":1,"symptomStages":"Stadium I (ab 3h): Scharfe Zähne wachsen, unstillbarer Hunger auf rohes Fleisch (-5 Psyche und -5 Organismus pro Tag). Stadium II (ab 6h): Krallen brechen aus den Fingern, Haarausfall, zunehmender Kontrollverlust. Stadium III (bei Psyche/Organismus 0): Vollständige Verwandlung in einen blutrünstigen Cardo.","damagePerStage":"-5 Psyche und -5 Organismus pro Tag","penaltiesPerStage":"Kontrollverlust bei Blutgeruch (Willenskraft gegen Intensität 10)","antidote":"Kein bekanntes Heilmittel","transmission":"Tröpfchen-, Blut- oder Kontaktinfektion","description":"<p><strong>SMF-V (Intensität 10):</strong> Der Sub-Mutagene-Fresszellen-Virus wird durch den Biss oder Speichel von Cardos übertragen und formt das Opfer unaufhaltsam selbst in einen Cardo um.</p>"},"effects":[],"flags":{}}
{"_id":"391486262577b7a0","_key":"!items!391486262577b7a0","name":"Steincobra-Kontaktgift","type":"condition","img":"icons/consumables/potions/bottle-conical-fumes-green.webp","folder":"01b52ba4538f93a2","system":{"conditionId":"cond_steincobra_kontaktgift","conditionType":"gift","incubationTime":"Sofort","testInterval":"Jede Kampfrunde (für 5 KR)","resistanceFormula":"@status.infektionsresistenz","intensity":9,"identificationMw":15,"currentStage":1,"symptomStages":"Wirkung über 5 Kampfrunden: Jede Kampfrunde 9 TP Giftschaden auf den Kopf (TZ 12) bei misslungener Widerstandsprobe gegen Intensität 9. Bei direktem Treffer in die Augen droht dauerhafte Erblindung.","damagePerStage":"9 TP pro Kampfrunde auf Kopf (TZ 12) für 5 KR","penaltiesPerStage":"Erblindung (-4W auf Sichtproben und Fernkampf)","antidote":"Antitoxin-Injektor oder sofortiges Ausspülen + Medizin MW 15","transmission":"Direkter Kontakt / Injektion","description":"<p><strong>Steincobra-Kontaktgift (Intensität 9):</strong> Hochätzendes Neuro- und Kontaktgift der Steincobra, das auf kurze Distanz in Gesicht und Augen gespieen wird.</p>"},"effects":[],"flags":{}}
{"_id":"a99faca8f4194cbc","_key":"!items!a99faca8f4194cbc","name":"Narkotisches Mutantengift","type":"condition","img":"icons/consumables/potions/vial-cork-green.webp","folder":"01b52ba4538f93a2","system":{"conditionId":"cond_narkotisches_mutantengift","conditionType":"gift","incubationTime":"Sofort","testInterval":"Einmalig bei Injektion (Wirkungsdauer 20 KR)","resistanceFormula":"@status.infektionsresistenz","intensity":6,"identificationMw":12,"currentStage":1,"symptomStages":"Stadium I: Schwere Lähmungserscheinungen (-3W6 auf alle Attribute für 20 Kampfrunden). Stadium II: Sinkt die Konstitution dadurch auf 0 oder darunter, fällt das Opfer sofort in tiefe Bewusstlosigkeit.","damagePerStage":"Kein Direktschaden (Paralyse)","penaltiesPerStage":"-3W6 auf alle Attribute für 20 KR; Bewusstlosigkeit bei KO ≤ 0","antidote":"Adrenalin-Schockinjektor oder Antitoxin","transmission":"Direkter Kontakt / Injektion","description":"<p><strong>Narkotisches Gift (Intensität 6):</strong> Von mutierten Raubtieren und Giftdrüsen-Mutanten produziertes Lähmungsgift, das Opfer binnen Sekunden wehrlos macht.</p>"},"effects":[],"flags":{}}
{"_id":"0bbc36f49d760528","_key":"!items!0bbc36f49d760528","name":"Toxisches Mutantengift","type":"condition","img":"icons/consumables/potions/potion-flask-corked-skull-poison-green.webp","folder":"01b52ba4538f93a2","system":{"conditionId":"cond_toxisches_mutantengift","conditionType":"gift","incubationTime":"Sofort","testInterval":"Jede Kampfrunde (für 3 KR)","resistanceFormula":"@status.infektionsresistenz","intensity":8,"identificationMw":15,"currentStage":1,"symptomStages":"Wirkung über 3 Kampfrunden: Verursacht jede Kampfrunde 6 TP Direktschaden (ignoriert Rüstung) auf Rumpf/Herz oder Kopf bei misslungener Widerstandsprobe gegen Intensität 8.","damagePerStage":"6 TP Direktschaden pro KR für 3 KR (Herz/Kopf)","penaltiesPerStage":"-1W auf alle Handlungen durch heftige Krämpfe","antidote":"Breitband-Antitoxin (Medizin MW 15)","transmission":"Direkter Kontakt / Injektion","description":"<p><strong>Toxisches Gift (Intensität 8):</strong> Tödliches Hämo- und Neurotoxin, das direkt das Herz-Kreislauf-System angreift.</p>"},"effects":[],"flags":{}}
{"_id":"8c7cefbe1083232e","_key":"!items!8c7cefbe1083232e","name":"Strahlungskrankheit (Akute Verstrahlung)","type":"condition","img":"icons/magic/light/explosion-star-glow-orange.webp","folder":"01b52ba4538f93a2","system":{"conditionId":"cond_strahlungskrankheit_akute_verstrahlung_","conditionType":"umwelt","incubationTime":"1–6 Stunden","testInterval":"Alle 24 Stunden","resistanceFormula":"@status.infektionsresistenz","intensity":6,"identificationMw":15,"currentStage":1,"symptomStages":"Grad I: Übelkeit, Kopfschmerzen, -1W6 Organismus. Grad II: Haarausfall, innere Blutungen, -2W6 Organismus und -1W auf alle körperlichen Proben. Grad III: Zellzerfall, -3W6 Organismus pro Tag bis zum Tod.","damagePerStage":"1W6 bis 3W6 Organismusverlust pro Tag","penaltiesPerStage":"-1W bis -3W auf Konstitutions- und Ausdauerproben","antidote":"Rad-Away / Dekontaminationsbehandlung + Jod-Stabilisatoren","transmission":"Direkter Kontakt / Injektion","description":"<p><strong>Strahlungskrankheit (Intensität 6):</strong> Folge längerer Aufenthalte in verstrahlten Kratern oder ohne Schutzanzug im Roten Nebel.</p>"},"effects":[],"flags":{}}
{"_id":"438721b21ac2bf76","_key":"!items!438721b21ac2bf76","name":"Säureverätzung (Saurer Regen / Ozean)","type":"condition","img":"icons/magic/acid/projectile-smoke-glowing.webp","folder":"01b52ba4538f93a2","system":{"conditionId":"cond_s_urever_tzung_saurer_regen_ozean_","conditionType":"gift","incubationTime":"Sofort bei Kontakt","testInterval":"Jede Kampfrunde / Minute im Kontakt","resistanceFormula":"@status.infektionsresistenz","intensity":5,"identificationMw":10,"currentStage":1,"symptomStages":"Ungeschützter Kontakt mit saurem Regen oder dem vergifteten Ozean verursacht 10p. bis 20p. Ätz- und Hitzeschaden pro Kampfrunde auf alle ungeschützten Trefferzonen.","damagePerStage":"10–20p. Ätzschaden pro KR auf ungeschützte Zonen","penaltiesPerStage":"Schmerzabzüge und Beschädigung unversiegelter Rüstung","antidote":"Neutralisationslösung, Schutzkleidung oder sofortige Dekontamination mit sauberem Wasser","transmission":"Direkter Kontakt / Injektion","description":"<p><strong>Säureverätzung (Intensität 5):</strong> Die toxischen Wolken und sauren Meere von NoReturn zerfressen ungeschützte Haut und gewöhnliche Kleidung binnen Sekunden.</p>"},"effects":[],"flags":{}}
