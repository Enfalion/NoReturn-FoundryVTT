<div class="noreturn-sheet item-sheet-root">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}" />
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'NORETURN.Personal.Name'}}" />
      </h1>
      <div class="item-subtitle">{{localize (concat "TYPES.Item." item.type)}}</div>
    </div>
  </header>

  <section class="sheet-body">
    <div class="nr-card">
      {{#if (eq itemType "skill")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Skills.Attribute"}}</span>
            <select name="system.attribute">
              <option value="" {{#if (eq system.attribute "")}}selected{{/if}}>–</option>
              <option value="geschick" {{#if (eq system.attribute "geschick")}}selected{{/if}}>{{localize "NORETURN.Attributes.geschick"}}</option>
              <option value="staerke" {{#if (eq system.attribute "staerke")}}selected{{/if}}>{{localize "NORETURN.Attributes.staerke"}}</option>
              <option value="konstitution" {{#if (eq system.attribute "konstitution")}}selected{{/if}}>{{localize "NORETURN.Attributes.konstitution"}}</option>
              <option value="schnelligkeit" {{#if (eq system.attribute "schnelligkeit")}}selected{{/if}}>{{localize "NORETURN.Attributes.schnelligkeit"}}</option>
              <option value="wissen" {{#if (eq system.attribute "wissen")}}selected{{/if}}>{{localize "NORETURN.Attributes.wissen"}}</option>
              <option value="wahrnehmung" {{#if (eq system.attribute "wahrnehmung")}}selected{{/if}}>{{localize "NORETURN.Attributes.wahrnehmung"}}</option>
              <option value="charisma" {{#if (eq system.attribute "charisma")}}selected{{/if}}>{{localize "NORETURN.Attributes.charisma"}}</option>
              <option value="logik" {{#if (eq system.attribute "logik")}}selected{{/if}}>{{localize "NORETURN.Attributes.logik"}}</option>
              <option value="fahrzeuge" {{#if (eq system.attribute "fahrzeuge")}}selected{{/if}}>{{localize "NORETURN.Attributes.fahrzeuge"}}</option>
            </select>
          </label>
          <label>
            <span>{{localize "NORETURN.Skills.Level"}}</span>
            <input type="number" name="system.level" value="{{system.level}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Skills.Mod"}}</span>
            <input type="number" name="system.mod" value="{{system.mod}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Skills.ZoneRef"}}</span>
            <input type="text" name="system.zoneReference" value="{{system.zoneReference}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Skills.BetaBio"}}</span>
            <input type="checkbox" name="system.betaBio" {{checked system.betaBio}} />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "styleskill")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Skills.Attribute"}}</span>
            <select name="system.attribute">
              <option value="charisma" {{#if (eq system.attribute "charisma")}}selected{{/if}}>{{localize "NORETURN.Attributes.charisma"}}</option>
              <option value="geschick" {{#if (eq system.attribute "geschick")}}selected{{/if}}>{{localize "NORETURN.Attributes.geschick"}}</option>
              <option value="staerke" {{#if (eq system.attribute "staerke")}}selected{{/if}}>{{localize "NORETURN.Attributes.staerke"}}</option>
              <option value="konstitution" {{#if (eq system.attribute "konstitution")}}selected{{/if}}>{{localize "NORETURN.Attributes.konstitution"}}</option>
              <option value="schnelligkeit" {{#if (eq system.attribute "schnelligkeit")}}selected{{/if}}>{{localize "NORETURN.Attributes.schnelligkeit"}}</option>
              <option value="wissen" {{#if (eq system.attribute "wissen")}}selected{{/if}}>{{localize "NORETURN.Attributes.wissen"}}</option>
              <option value="wahrnehmung" {{#if (eq system.attribute "wahrnehmung")}}selected{{/if}}>{{localize "NORETURN.Attributes.wahrnehmung"}}</option>
              <option value="logik" {{#if (eq system.attribute "logik")}}selected{{/if}}>{{localize "NORETURN.Attributes.logik"}}</option>
            </select>
          </label>
          <label>
            <span>{{localize "NORETURN.Skills.Level"}}</span>
            <input type="number" name="system.level" value="{{system.level}}" min="0" max="{{system.maxLevel}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Skills.Mod"}}</span>
            <input type="number" name="system.mod" value="{{system.mod}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.StyleSkills.Requirements"}}</span>
            <input type="text" name="system.requirements" value="{{system.requirements}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.StyleSkills.PassiveBonus"}}</span>
            <input type="text" name="system.passiveBonus" value="{{system.passiveBonus}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Species.SkillModifiers"}}</span>
            <input type="text" name="system.skillModifiers" value="{{system.skillModifiers}}" />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "psiForce")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.PSI.Category"}}</span>
            <select name="system.psiCategory">
              <option value="A" {{#if (eq system.psiCategory "A")}}selected{{/if}}>{{localize "NORETURN.PSI.CategoryA"}}</option>
              <option value="B" {{#if (eq system.psiCategory "B")}}selected{{/if}}>{{localize "NORETURN.PSI.CategoryB"}}</option>
            </select>
          </label>
          <label>
            <span>{{localize "NORETURN.PSI.HierarchyTier"}}</span>
            <select name="system.hierarchyTier" data-dtype="Number">
              <option value="1" {{#if (eq system.hierarchyTier 1)}}selected{{/if}}>Hierarchiestufe 1 (Cryo/Elektro/Pyro/Tele)</option>
              <option value="2" {{#if (eq system.hierarchyTier 2)}}selected{{/if}}>Hierarchiestufe 2 (Anima/Momen/Photo/Psycho)</option>
              <option value="3" {{#if (eq system.hierarchyTier 3)}}selected{{/if}}>Hierarchiestufe 3 (Bio/Crono/Morpho/Techno)</option>
            </select>
          </label>
          <label>
            <span>{{localize "NORETURN.PSI.ManualHierarchyOverride"}}</span>
            <input type="checkbox" name="system.manualHierarchyOverride" {{checked system.manualHierarchyOverride}} />
          </label>
          <label>
            <span>{{localize "NORETURN.Skills.Level"}}</span>
            <input type="number" name="system.level" value="{{system.level}}" min="0" max="3" />
          </label>
          <label>
            <span>{{localize "NORETURN.Skills.Mod"}}</span>
            <input type="number" name="system.mod" value="{{system.mod}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.PSI.Mastery"}}</span>
            <input type="checkbox" name="system.mastery" {{checked system.mastery}} />
          </label>
          <label>
            <span>{{localize "NORETURN.PSI.CanOverload"}}</span>
            <input type="checkbox" name="system.canOverload" {{checked system.canOverload}} />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "psiApp")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.PSI.Category"}}</span>
            <select name="system.psiCategory">
              <option value="A" {{#if (eq system.psiCategory "A")}}selected{{/if}}>{{localize "NORETURN.PSI.CategoryA"}}</option>
              <option value="B" {{#if (eq system.psiCategory "B")}}selected{{/if}}>{{localize "NORETURN.PSI.CategoryB"}}</option>
            </select>
          </label>
          <label>
            <span>{{localize "NORETURN.PSI.ForceName"}}</span>
            <input type="text" name="system.psiForce" value="{{system.psiForce}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.PSI.AppTier"}}</span>
            <select name="system.tier" data-dtype="Number">
              <option value="1" {{#if (eq system.tier 1)}}selected{{/if}}>Stufe 1 (8–12 / Kat. B: 11–15)</option>
              <option value="2" {{#if (eq system.tier 2)}}selected{{/if}}>Stufe 2 (15–19)</option>
              <option value="3" {{#if (eq system.tier 3)}}selected{{/if}}>Stufe 3 (19–22 / Kat. B: 23–25)</option>
            </select>
          </label>
          <label>
            <span>{{localize "NORETURN.PSI.TargetCorridor"}} (Min – Max)</span>
            <div class="flexrow">
              <input type="number" name="system.targetMin" value="{{system.targetMin}}" min="1" />
              <input type="number" name="system.targetMax" value="{{system.targetMax}}" min="1" />
            </div>
          </label>
          <label>
            <span>{{localize "NORETURN.PSI.Cost"}} [KS]</span>
            <input type="text" name="system.cost" value="{{system.cost}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.PSI.DefensiveMode"}}</span>
            <select name="system.defensiveMode">
              <option value="" {{#if (eq system.defensiveMode "")}}selected{{/if}}>–</option>
              <option value="block" {{#if (eq system.defensiveMode "block")}}selected{{/if}}>Blocken</option>
              <option value="dodge" {{#if (eq system.defensiveMode "dodge")}}selected{{/if}}>Ausweichen</option>
            </select>
          </label>
          <label>
            <span>{{localize "NORETURN.PSI.Range"}}</span>
            <input type="text" name="system.range" value="{{system.range}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.PSI.Duration"}}</span>
            <input type="text" name="system.duration" value="{{system.duration}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.PSI.RollFormula"}}</span>
            <input type="text" name="system.rollFormula" value="{{system.rollFormula}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Consumables.Active"}}</span>
            <input type="checkbox" name="system.active" {{checked system.active}} />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Inventory.Effects"}}</span>
            <input type="text" name="system.effects" value="{{system.effects}}" />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "weapon")}}
        <div class="nr-stat-grid">
          <label class="full-span">
            <span>{{localize "NORETURN.Combat.WeaponCategory"}}</span>
            <select class="nr-weapon-mode-select">
              <option value="ranged" {{#if (eq weaponModeGroup "ranged")}}selected{{/if}}>Fernkampfwaffe (Schießen / Schwere Waffen / Wurfwaffen)</option>
              <option value="kurzdistanz" {{#if (eq weaponModeGroup "kurzdistanz")}}selected{{/if}}>Kurzdistanzwaffe (KW) – Nahkampf (GRW S. 64 &amp; 235)</option>
              <option value="distanzwaffe" {{#if (eq weaponModeGroup "distanzwaffe")}}selected{{/if}}>Distanzwaffe (DW) – Waffenkampf &amp; Parade (GRW S. 65 &amp; 235)</option>
              <option value="natural" {{#if (eq weaponModeGroup "natural")}}selected{{/if}}>Natürliche Waffe / Biowaffe – Nahkampf (GRW S. 73 &amp; 168)</option>
            </select>
          </label>

          {{#if system.isRanged}}
            <label>
              <span>{{localize "NORETURN.Combat.Skill"}}</span>
              <select name="system.skill">
                <option value="schiessen" {{#if (or (eq system.skill "schiessen") (eq system.skill "schusswaffen"))}}selected{{/if}}>Schießen (Feuerwaffen)</option>
                <option value="schwere_waffen" {{#if (eq system.skill "schwere_waffen")}}selected{{/if}}>Schwere Waffen</option>
                <option value="projektilwaffen" {{#if (eq system.skill "projektilwaffen")}}selected{{/if}}>Projektilwaffen</option>
                <option value="wurfwaffen" {{#if (eq system.skill "wurfwaffen")}}selected{{/if}}>Wurfwaffen</option>
                <option value="spruehwaffen" {{#if (eq system.skill "spruehwaffen")}}selected{{/if}}>Sprühwaffen</option>
              </select>
            </label>
            <label>
              <span>{{localize "NORETURN.Combat.AttackBonus"}} (+/- W6)</span>
              <input type="number" name="system.attackBonus" value="{{system.attackBonus}}" />
            </label>
            <label>
              <span>{{localize "NORETURN.Combat.Damage"}} (Formel)</span>
              <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" />
            </label>
            <label>
              <span>Grundschaden (Flat TP)</span>
              <input type="number" name="system.damageFlat" value="{{system.damageFlat}}" step="1" />
            </label>
            <label>
              <span>Schaden einer Kugel (pro Treffer/Salve)</span>
              <input type="number" name="system.damageBonusPerHit" value="{{system.damageBonusPerHit}}" min="0" step="1" />
            </label>
            <label>
              <span>{{localize "NORETURN.Combat.Caliber"}}</span>
              <input type="text" name="system.caliber" value="{{system.caliber}}" />
            </label>
            <label>
              <span>{{localize "NORETURN.Combat.Magazine"}} (Text)</span>
              <input type="text" name="system.magazine" value="{{system.magazine}}" />
            </label>
            <label>
              <span>{{localize "NORETURN.Combat.MagazineCapacity"}} (Schuss)</span>
              <input type="number" name="system.magazineCapacity" value="{{system.magazineCapacity}}" min="0" step="1" />
            </label>
            <label>
              <span>{{localize "NORETURN.Combat.AmmoCurrent"}} (Geladen)</span>
              <input type="number" name="system.ammoCurrent" value="{{system.ammoCurrent}}" min="0" step="1" />
            </label>
            <label>
              <span>{{localize "NORETURN.Combat.AmmoLoaded"}}</span>
              <select class="nr-item-weapon-ammo-select">
                <option value="unload" {{#if (and (eq system.ammoCurrent 0) (eq system.loadedAmmoId ""))}}selected{{/if}}>
                  – Nicht geladen –
                </option>
                {{#if compatibleAmmoItems.length}}
                  <optgroup label="Inventar ({{system.caliber}})">
                    {{#each compatibleAmmoItems}}
                      <option value="item:{{this.id}}" {{#if (eq ../system.loadedAmmoId this.id)}}selected{{/if}}>
                        {{this.name}} [{{this.system.ammoType}}] ({{this.system.quantity}}x)
                      </option>
                    {{/each}}
                  </optgroup>
                {{/if}}
                <optgroup label="Munitionstyp (Standard)">
                  {{#each ammoTypes}}
                    <option value="type:{{this.code}}" {{#if (and (gt ../system.ammoCurrent 0) (eq ../system.loadedAmmoId "") (eq ../system.loadedAmmoType this.code))}}selected{{/if}}>
                      {{this.label}} ({{this.effect}})
                    </option>
                  {{/each}}
                </optgroup>
              </select>
            </label>
            <label>
              <span>{{localize "NORETURN.Combat.RD"}}</span>
              <input type="number" name="system.recoilDampening" value="{{system.recoilDampening}}" min="0" />
            </label>
            <label>
              <span>{{localize "NORETURN.Combat.FireModes"}}</span>
              <input type="text" name="system.fireModes" value="{{system.fireModes}}" />
            </label>
            <label>
              <span>{{localize "NORETURN.Combat.Range"}}</span>
              <input type="text" name="system.range" value="{{system.range}}" />
            </label>
            <label>
              <span>{{localize "NORETURN.Inventory.Price"}}</span>
              <input type="number" name="system.price" value="{{system.price}}" min="0" />
            </label>
          {{else}}
            <label>
              <span>{{localize "NORETURN.Combat.Skill"}}</span>
              <select name="system.skill">
                <option value="nahkampf" {{#if (eq system.skill "nahkampf")}}selected{{/if}}>Nahkampf (KW / Natürliche Waffe)</option>
                <option value="waffenkampf" {{#if (eq system.skill "waffenkampf")}}selected{{/if}}>Waffenkampf (DW)</option>
              </select>
            </label>
            <label>
              <span>{{localize "NORETURN.Combat.AttackBonus"}} (+/- W6)</span>
              <input type="number" name="system.attackBonus" value="{{system.attackBonus}}" step="1" />
            </label>
            <label>
              <span>{{localize "NORETURN.Combat.ParryBonus"}} (+/- W6)</span>
              <input type="number" name="system.parryBonus" value="{{system.parryBonus}}" step="1" />
            </label>
            <label>
              <span>Parade erlaubt (Distanzwaffe DW)</span>
              <input type="checkbox" name="system.parryAllowed" {{checked system.parryAllowed}} />
            </label>
            <label>
              <span>Fester Schadensbonus zu Stärke (+p. TP)</span>
              <input type="number" name="system.damageFlat" value="{{system.damageFlat}}" step="1" />
            </label>
            <label>
              <span>{{localize "NORETURN.Combat.Damage"}} (Formel, z. B. ST+20p.)</span>
              <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" />
            </label>
            <label class="full-span">
              <span>Effektive Schadensberechnung (Stärke W6 inkl. Hazard-Di + fester Bonus)</span>
              <input type="text" value="{{system.effectiveDamageDisplay}}" disabled />
            </label>
            <label>
              <span>{{localize "NORETURN.Inventory.Price"}}</span>
              <input type="number" name="system.price" value="{{system.price}}" min="0" />
            </label>
          {{/if}}
        </div>
      {{/if}}

      {{#if (eq itemType "armor")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Health.Armor"}}</span>
            <input type="number" name="system.armorValue" value="{{system.armorValue}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Health.MaterialCategoryLong"}}</span>
            <select name="system.materialCategory">
              <option value="A" {{#if (eq system.materialCategory "A")}}selected{{/if}}>A</option>
              <option value="B" {{#if (eq system.materialCategory "B")}}selected{{/if}}>B</option>
              <option value="C" {{#if (eq system.materialCategory "C")}}selected{{/if}}>C</option>
            </select>
          </label>
          <label>
            <span>Komfort (Min. KO ohne Malus)</span>
            <input type="number" name="system.comfort" value="{{system.comfort}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Inventory.Price"}}</span>
            <input type="number" name="system.price" value="{{system.price}}" min="0" />
          </label>
          <label class="full-span">
            <span>Frei wählbare Einzelzone („je Zone“, z. B. Partielle Panzerungsglieder)</span>
            <input type="checkbox" name="system.isSelectableZone" {{checked system.isSelectableZone}} />
          </label>
          <div class="full-span nr-armor-zones-section">
            <span class="nr-section-label">Geschützte Trefferzonen (2 bis 12 – anklicken zum An-/Abwählen): <strong>{{system.zonesLabel}}</strong></span>
            <div class="nr-armor-zones-grid">
              {{#each armorZoneOptions}}
                <label class="nr-armor-zone-chip {{#if this.checked}}active{{/if}}">
                  <input type="checkbox" class="nr-armor-zone-checkbox" value="{{this.num}}" {{checked this.checked}} />
                  <span>{{this.label}}</span>
                </label>
              {{/each}}
            </div>
          </div>
        </div>
      {{/if}}

      {{#if (or (eq itemType "gear") (eq itemType "ammo"))}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Inventory.Quantity"}}</span>
            <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Inventory.Weight"}}</span>
            <input type="number" name="system.weight" value="{{system.weight}}" step="0.05" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Inventory.Price"}}</span>
            <input type="number" name="system.price" value="{{system.price}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Inventory.TechLevel"}}</span>
            <input type="text" name="system.techLevel" value="{{system.techLevel}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Combat.Caliber"}} (falls Munition)</span>
            <input type="text" name="system.caliber" value="{{system.caliber}}" placeholder="z.B. 9mm P3" />
          </label>
          <label>
            <span>{{localize "NORETURN.Combat.AmmoLoaded"}} (Typ)</span>
            <select name="system.ammoType">
              <option value="" {{#if (eq system.ammoType "")}}selected{{/if}}>– Keine Munition –</option>
              <option value="FMJ" {{#if (eq system.ammoType "FMJ")}}selected{{/if}}>FMJ – Vollmantel (+0 TP)</option>
              <option value="AP" {{#if (eq system.ammoType "AP")}}selected{{/if}}>AP – Hartkern (+0 TP | ignoriert MK:A)</option>
              <option value="HS" {{#if (eq system.ammoType "HS")}}selected{{/if}}>HS – Hohlspitz (+10 TP vs. MK:A | 0 vs. MK:B+)</option>
              <option value="AF" {{#if (eq system.ammoType "AF")}}selected{{/if}}>AF – Anti-Fahrzeug (+10 TP | ignoriert MK:A &amp; B)</option>
            </select>
          </label>
          <label>
            <span>Schadens-Modifikator (leer = Standard laut Typ)</span>
            <input type="number" name="system.damageMod" value="{{system.damageMod}}" step="1" placeholder="z.B. 0 oder 10" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Inventory.Effects"}}</span>
            <input type="text" name="system.effects" value="{{system.effects}}" />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "consumable")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Inventory.Quantity"}}</span>
            <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Consumables.Dosage"}}</span>
            <input type="text" name="system.dosage" value="{{system.dosage}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Consumables.Duration"}}</span>
            <input type="text" name="system.duration" value="{{system.duration}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Consumables.Addiction"}}</span>
            <input type="text" name="system.addictionRating" value="{{system.addictionRating}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Inventory.Price"}}</span>
            <input type="number" name="system.price" value="{{system.price}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Consumables.Active"}}</span>
            <input type="checkbox" name="system.active" {{checked system.active}} />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Consumables.StatBoosts"}}</span>
            <input type="text" name="system.statBoosts" value="{{system.statBoosts}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Consumables.Drawbacks"}}</span>
            <input type="text" name="system.drawbacks" value="{{system.drawbacks}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Species.SkillModifiers"}}</span>
            <input type="text" name="system.skillModifiers" value="{{system.skillModifiers}}" />
          </label>
        </div>
      {{/if}}

      {{#if (or (eq itemType "cyberware") (eq itemType "robotModule"))}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Inventory.Installed"}}</span>
            <input type="checkbox" name="system.installed" {{checked system.installed}} />
          </label>
          <label>
            <span>{{localize "NORETURN.Health.Zone"}}</span>
            <input type="text" name="system.targetZone" value="{{system.targetZone}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Robotics.Capacity"}}</span>
            <input type="number" name="system.capacityCost" value="{{system.capacityCost}}" step="0.25" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Status.Organismus"}} ({{localize "NORETURN.Status.CyberwareCost"}})</span>
            <input type="number" name="system.organismCost" value="{{system.organismCost}}" step="0.5" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Robotics.EnergyDrain"}}</span>
            <input type="number" name="system.energyDrain" value="{{system.energyDrain}}" step="0.25" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Inventory.Price"}}</span>
            <input type="number" name="system.price" value="{{system.price}}" min="0" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Inventory.Effects"}}</span>
            <input type="text" name="system.effects" value="{{system.effects}}" />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "species")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Species.Subspecies"}}</span>
            <input type="text" name="system.subspecies" value="{{system.subspecies}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Species.CostGp"}}</span>
            <input type="number" name="system.costGp" value="{{system.costGp}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Species.Legality"}}</span>
            <input type="text" name="system.legality" value="{{system.legality}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Status.Infektionsresistenz"}}</span>
            <input type="text" name="system.baseStats.infektionsresistenz" value="{{system.baseStats.infektionsresistenz}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Status.Psyche"}}</span>
            <input type="number" name="system.baseStats.psyche" value="{{system.baseStats.psyche}}" min="0" max="100" />
          </label>
          <label>
            <span>{{localize "NORETURN.Attributes.adrenalin"}}</span>
            <input type="number" name="system.baseStats.adrenalin" value="{{system.baseStats.adrenalin}}" min="0" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Species.SkillModifiers"}}</span>
            <input type="text" name="system.skillModifiers" value="{{system.skillModifiers}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Species.SpecialRules"}}</span>
            <input type="text" name="system.specialRules" value="{{system.specialRules}}" />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "mutation")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Skills.Category"}}</span>
            <select name="system.category">
              <option value="sichtbar" {{#if (eq system.category "sichtbar")}}selected{{/if}}>{{localize "NORETURN.Species.Categories.sichtbar"}}</option>
              <option value="verborgen" {{#if (eq system.category "verborgen")}}selected{{/if}}>{{localize "NORETURN.Species.Categories.verborgen"}}</option>
              <option value="abnormitaet" {{#if (eq system.category "abnormitaet")}}selected{{/if}}>{{localize "NORETURN.Species.Categories.abnormitaet"}}</option>
              <option value="auffaelligkeit" {{#if (eq system.category "auffaelligkeit")}}selected{{/if}}>{{localize "NORETURN.Species.Categories.auffaelligkeit"}}</option>
            </select>
          </label>
          <label>
            <span>{{localize "NORETURN.Skills.Level"}}</span>
            <input type="number" name="system.level" value="{{system.level}}" min="1" max="{{system.maxLevel}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Species.CostMp"}}</span>
            <input type="number" name="system.costMp" value="{{system.costMp}}" step="0.5" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Species.CostGp"}}</span>
            <input type="number" name="system.costGp" value="{{system.costGp}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Status.Organismus"}}</span>
            <input type="number" name="system.organismusCost" value="{{system.organismusCost}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Status.Psyche"}}</span>
            <input type="number" name="system.psycheCost" value="{{system.psycheCost}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Species.SkillModifiers"}}</span>
            <input type="text" name="system.skillModifiers" value="{{system.skillModifiers}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Inventory.Effects"}}</span>
            <input type="text" name="system.effects" value="{{system.effects}}" />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "trait")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Skills.Category"}}</span>
            <select name="system.traitType">
              <option value="justice" {{#if (eq system.traitType "justice")}}selected{{/if}}>Justice (JP)</option>
              <option value="chaos" {{#if (eq system.traitType "chaos")}}selected{{/if}}>Chaos (CP)</option>
              <option value="begabung" {{#if (eq system.traitType "begabung")}}selected{{/if}}>Begabung</option>
              <option value="talent" {{#if (eq system.traitType "talent")}}selected{{/if}}>Talent</option>
            </select>
          </label>
          <label>
            <span>{{localize "NORETURN.Traits.Cost"}}</span>
            <input type="number" name="system.cost" value="{{system.cost}}" min="0" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Traits.PassiveModifiers"}}</span>
            <input type="text" name="system.passiveModifiers" value="{{system.passiveModifiers}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Species.SkillModifiers"}}</span>
            <input type="text" name="system.skillModifiers" value="{{system.skillModifiers}}" />
          </label>
        </div>
      {{/if}}

      {{#if (or (eq itemType "condition") (eq itemType "disease") (eq itemType "toxin"))}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Conditions.Incubation"}}</span>
            <input type="text" name="system.incubationTime" value="{{system.incubationTime}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Conditions.Interval"}}</span>
            <input type="text" name="system.testInterval" value="{{system.testInterval}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Conditions.ResistanceRoll"}}</span>
            <input type="text" name="system.resistanceFormula" value="{{system.resistanceFormula}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Conditions.Intensity"}}</span>
            <input type="number" name="system.intensity" value="{{system.intensity}}" min="1" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Conditions.SymptomStages"}}</span>
            <input type="text" name="system.symptomStages" value="{{system.symptomStages}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Conditions.DamagePenalties"}}</span>
            <input type="text" name="system.damagePerStage" value="{{system.damagePerStage}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Conditions.Antidote"}}</span>
            <input type="text" name="system.antidote" value="{{system.antidote}}" />
          </label>
        </div>
      {{/if}}

      <hr />
      <label class="full-span">
        <span>{{localize "NORETURN.Inventory.Description"}}</span>
        <textarea class="nr-notes-area" name="system.description" rows="6">{{descriptionText}}</textarea>
      </label>
    </div>
  </section>
</div>
