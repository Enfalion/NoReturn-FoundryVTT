<div class="noreturn-sheet item-sheet-root">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'NORETURN.Personal.Name'}}" />
      </h1>
      <div class="item-subtitle">{{localize (concat "TYPES.Item." item.type)}}</div>
    </div>
  </header>

  <section class="sheet-body">
    <div class="nr-card">
      {{#if (eq itemType "skill")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Skills.Attribute"}}</span>
            <select name="system.attribute">
              <option value="" {{#if (eq system.attribute "")}}selected{{/if}}>–</option>
              <option value="geschick" {{#if (eq system.attribute "geschick")}}selected{{/if}}>{{localize "NORETURN.Attributes.geschick"}}</option>
              <option value="staerke" {{#if (eq system.attribute "staerke")}}selected{{/if}}>{{localize "NORETURN.Attributes.staerke"}}</option>
              <option value="konstitution" {{#if (eq system.attribute "konstitution")}}selected{{/if}}>{{localize "NORETURN.Attributes.konstitution"}}</option>
              <option value="schnelligkeit" {{#if (eq system.attribute "schnelligkeit")}}selected{{/if}}>{{localize "NORETURN.Attributes.schnelligkeit"}}</option>
              <option value="wissen" {{#if (eq system.attribute "wissen")}}selected{{/if}}>{{localize "NORETURN.Attributes.wissen"}}</option>
              <option value="wahrnehmung" {{#if (eq system.attribute "wahrnehmung")}}selected{{/if}}>{{localize "NORETURN.Attributes.wahrnehmung"}}</option>
              <option value="charisma" {{#if (eq system.attribute "charisma")}}selected{{/if}}>{{localize "NORETURN.Attributes.charisma"}}</option>
              <option value="logik" {{#if (eq system.attribute "logik")}}selected{{/if}}>{{localize "NORETURN.Attributes.logik"}}</option>
              <option value="fahrzeuge" {{#if (eq system.attribute "fahrzeuge")}}selected{{/if}}>{{localize "NORETURN.Attributes.fahrzeuge"}}</option>
            </select>
          </label>
          <label>
            <span>{{localize "NORETURN.Skills.Level"}}</span>
            <input type="number" name="system.level" value="{{system.level}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Skills.Mod"}}</span>
            <input type="number" name="system.mod" value="{{system.mod}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Skills.ZoneRef"}}</span>
            <input type="text" name="system.zoneReference" value="{{system.zoneReference}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Skills.BetaBio"}}</span>
            <input type="checkbox" name="system.betaBio" {{checked system.betaBio}} />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "weapon")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Combat.Skill"}}</span>
            <input type="text" name="system.skill" value="{{system.skill}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Combat.AttackBonus"}}</span>
            <input type="number" name="system.attackBonus" value="{{system.attackBonus}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Combat.Damage"}}</span>
            <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Combat.Caliber"}}</span>
            <input type="text" name="system.caliber" value="{{system.caliber}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Combat.Magazine"}}</span>
            <input type="text" name="system.magazine" value="{{system.magazine}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Combat.RD"}}</span>
            <input type="number" name="system.recoilDampening" value="{{system.recoilDampening}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Combat.FireModes"}}</span>
            <input type="text" name="system.fireModes" value="{{system.fireModes}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Inventory.Price"}}</span>
            <input type="number" name="system.price" value="{{system.price}}" min="0" />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "armor")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Health.Armor"}}</span>
            <input type="number" name="system.armorValue" value="{{system.armorValue}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Health.MaterialCategory"}}</span>
            <select name="system.materialCategory">
              <option value="A" {{#if (eq system.materialCategory "A")}}selected{{/if}}>A</option>
              <option value="B" {{#if (eq system.materialCategory "B")}}selected{{/if}}>B</option>
              <option value="C" {{#if (eq system.materialCategory "C")}}selected{{/if}}>C</option>
            </select>
          </label>
          <label>
            <span>{{localize "NORETURN.Health.Zone"}}</span>
            <input type="text" name="system.zonesLabel" value="{{system.zonesLabel}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Inventory.Price"}}</span>
            <input type="number" name="system.price" value="{{system.price}}" min="0" />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "gear")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Inventory.Quantity"}}</span>
            <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Inventory.Weight"}}</span>
            <input type="number" name="system.weight" value="{{system.weight}}" step="0.05" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Inventory.Price"}}</span>
            <input type="number" name="system.price" value="{{system.price}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Inventory.TechLevel"}}</span>
            <input type="text" name="system.techLevel" value="{{system.techLevel}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Inventory.Effects"}}</span>
            <input type="text" name="system.effects" value="{{system.effects}}" />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "consumable")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Inventory.Quantity"}}</span>
            <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Consumables.Dosage"}}</span>
            <input type="text" name="system.dosage" value="{{system.dosage}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Consumables.Duration"}}</span>
            <input type="text" name="system.duration" value="{{system.duration}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Consumables.Addiction"}}</span>
            <input type="text" name="system.addictionRating" value="{{system.addictionRating}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Inventory.Price"}}</span>
            <input type="number" name="system.price" value="{{system.price}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Consumables.Active"}}</span>
            <input type="checkbox" name="system.active" {{checked system.active}} />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Consumables.StatBoosts"}}</span>
            <input type="text" name="system.statBoosts" value="{{system.statBoosts}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Consumables.Drawbacks"}}</span>
            <input type="text" name="system.drawbacks" value="{{system.drawbacks}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Species.SkillModifiers"}}</span>
            <input type="text" name="system.skillModifiers" value="{{system.skillModifiers}}" />
          </label>
        </div>
      {{/if}}

      {{#if (or (eq itemType "cyberware") (eq itemType "robotModule"))}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Health.Zone"}}</span>
            <input type="text" name="system.targetZone" value="{{system.targetZone}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Robotics.Capacity"}}</span>
            <input type="number" name="system.capacityCost" value="{{system.capacityCost}}" step="0.25" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Status.Organismus"}}</span>
            <input type="number" name="system.organismusCost" value="{{system.organismusCost}}" step="0.5" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Robotics.EnergyDrain"}}</span>
            <input type="number" name="system.energyDrain" value="{{system.energyDrain}}" step="0.25" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Inventory.Price"}}</span>
            <input type="number" name="system.price" value="{{system.price}}" min="0" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Inventory.Effects"}}</span>
            <input type="text" name="system.effects" value="{{system.effects}}" />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "species")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Species.Subspecies"}}</span>
            <input type="text" name="system.subspecies" value="{{system.subspecies}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Species.CostGp"}}</span>
            <input type="number" name="system.costGp" value="{{system.costGp}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Species.Legality"}}</span>
            <input type="text" name="system.legality" value="{{system.legality}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Status.Infektionsresistenz"}}</span>
            <input type="text" name="system.baseStats.infektionsresistenz" value="{{system.baseStats.infektionsresistenz}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Status.Psyche"}}</span>
            <input type="number" name="system.baseStats.psyche" value="{{system.baseStats.psyche}}" min="0" max="100" />
          </label>
          <label>
            <span>{{localize "NORETURN.Attributes.adrenalin"}}</span>
            <input type="number" name="system.baseStats.adrenalin" value="{{system.baseStats.adrenalin}}" min="0" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Species.SkillModifiers"}}</span>
            <input type="text" name="system.skillModifiers" value="{{system.skillModifiers}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Species.SpecialRules"}}</span>
            <input type="text" name="system.specialRules" value="{{system.specialRules}}" />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "mutation")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Skills.Category"}}</span>
            <select name="system.category">
              <option value="sichtbar" {{#if (eq system.category "sichtbar")}}selected{{/if}}>{{localize "NORETURN.Species.Categories.sichtbar"}}</option>
              <option value="verborgen" {{#if (eq system.category "verborgen")}}selected{{/if}}>{{localize "NORETURN.Species.Categories.verborgen"}}</option>
              <option value="abnormitaet" {{#if (eq system.category "abnormitaet")}}selected{{/if}}>{{localize "NORETURN.Species.Categories.abnormitaet"}}</option>
              <option value="auffaelligkeit" {{#if (eq system.category "auffaelligkeit")}}selected{{/if}}>{{localize "NORETURN.Species.Categories.auffaelligkeit"}}</option>
            </select>
          </label>
          <label>
            <span>{{localize "NORETURN.Skills.Level"}}</span>
            <input type="number" name="system.level" value="{{system.level}}" min="1" max="{{system.maxLevel}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Species.CostMp"}}</span>
            <input type="number" name="system.costMp" value="{{system.costMp}}" step="0.5" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Species.CostGp"}}</span>
            <input type="number" name="system.costGp" value="{{system.costGp}}" min="0" />
          </label>
          <label>
            <span>{{localize "NORETURN.Status.Organismus"}}</span>
            <input type="number" name="system.organismusCost" value="{{system.organismusCost}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Status.Psyche"}}</span>
            <input type="number" name="system.psycheCost" value="{{system.psycheCost}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Species.SkillModifiers"}}</span>
            <input type="text" name="system.skillModifiers" value="{{system.skillModifiers}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Inventory.Effects"}}</span>
            <input type="text" name="system.effects" value="{{system.effects}}" />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "trait")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Skills.Category"}}</span>
            <select name="system.traitType">
              <option value="justice" {{#if (eq system.traitType "justice")}}selected{{/if}}>Justice (JP)</option>
              <option value="chaos" {{#if (eq system.traitType "chaos")}}selected{{/if}}>Chaos (CP)</option>
              <option value="begabung" {{#if (eq system.traitType "begabung")}}selected{{/if}}>Begabung</option>
              <option value="talent" {{#if (eq system.traitType "talent")}}selected{{/if}}>Talent</option>
            </select>
          </label>
          <label>
            <span>{{localize "NORETURN.Traits.Cost"}}</span>
            <input type="number" name="system.cost" value="{{system.cost}}" min="0" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Traits.PassiveModifiers"}}</span>
            <input type="text" name="system.passiveModifiers" value="{{system.passiveModifiers}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Species.SkillModifiers"}}</span>
            <input type="text" name="system.skillModifiers" value="{{system.skillModifiers}}" />
          </label>
        </div>
      {{/if}}

      {{#if (eq itemType "condition")}}
        <div class="nr-stat-grid">
          <label>
            <span>{{localize "NORETURN.Conditions.Incubation"}}</span>
            <input type="text" name="system.incubationTime" value="{{system.incubationTime}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Conditions.Interval"}}</span>
            <input type="text" name="system.testInterval" value="{{system.testInterval}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Conditions.ResistanceRoll"}}</span>
            <input type="text" name="system.resistanceFormula" value="{{system.resistanceFormula}}" />
          </label>
          <label>
            <span>{{localize "NORETURN.Conditions.Intensity"}}</span>
            <input type="number" name="system.intensity" value="{{system.intensity}}" min="1" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Conditions.SymptomStages"}}</span>
            <input type="text" name="system.symptomStages" value="{{system.symptomStages}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Conditions.DamagePenalties"}}</span>
            <input type="text" name="system.damagePerStage" value="{{system.damagePerStage}}" />
          </label>
          <label class="full-span">
            <span>{{localize "NORETURN.Conditions.Antidote"}}</span>
            <input type="text" name="system.antidote" value="{{system.antidote}}" />
          </label>
        </div>
      {{/if}}

      <hr />
      <label class="full-span">
        <span>{{localize "NORETURN.Traits.Notes"}}</span>
        <textarea class="nr-notes-area" name="system.description" rows="6">{{system.description}}</textarea>
      </label>
    </div>
  </section>
</div>
