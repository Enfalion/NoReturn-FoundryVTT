<div class="noreturn-sheet robot-sheet-root">
  <!-- Robotics Sheet Header -->
  <header class="sheet-header robot-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="header-fields">
      <div class="header-top-row">
        <h1 class="charname">
          <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'NORETURN.Personal.Name'}}" />
        </h1>
        <div class="header-quick-actions">
          <button type="button" class="nr-btn" data-action="rollHitZone">
            <i class="fas fa-crosshairs"></i> {{localize "NORETURN.Health.RollHitZone"}}
          </button>
        </div>
      </div>

      <div class="personal-grid">
        <label>
          <span>{{localize "NORETURN.Personal.Modell"}}</span>
          <input type="text" name="system.personal.modell" value="{{system.personal.modell}}" />
        </label>
        <label>
          <span>{{localize "NORETURN.Personal.Seriennummer"}}</span>
          <input type="text" name="system.personal.seriennummer" value="{{system.personal.seriennummer}}" />
        </label>
        <label>
          <span>{{localize "NORETURN.Personal.Hersteller"}}</span>
          <input type="text" name="system.personal.hersteller" value="{{system.personal.hersteller}}" />
        </label>
        <label>
          <span>{{localize "NORETURN.Personal.Besitzer"}}</span>
          <input type="text" name="system.personal.besitzer" value="{{system.personal.besitzer}}" />
        </label>
        <label>
          <span>{{localize "NORETURN.Status.OrganismusVerlust"}}</span>
          <input type="number" value="{{system.allOver.summeOrganismusverlust}}" disabled />
        </label>
        <label>
          <span>{{localize "NORETURN.Status.Organismus"}}</span>
          <input type="number" value="{{system.allOver.restOrganismus}}" disabled />
        </label>
      </div>
    </div>
  </header>

  <!-- Navigation Tabs -->
  <nav class="sheet-tabs tabs" role="tablist">
    <a class="item {{#if (eq activeTab 'zones')}}active{{/if}}" data-action="switchTab" data-tab="zones">
      <i class="fas fa-robot"></i> {{localize "NORETURN.Sheet.Tabs.RobotZones"}}
    </a>
    <a class="item {{#if (eq activeTab 'modules')}}active{{/if}}" data-action="switchTab" data-tab="modules">
      <i class="fas fa-microchip"></i> {{localize "NORETURN.Sheet.Tabs.RobotModules"}}
    </a>
    <a class="item {{#if (eq activeTab 'combat')}}active{{/if}}" data-action="switchTab" data-tab="combat">
      <i class="fas fa-crosshairs"></i> {{localize "NORETURN.Sheet.Tabs.Combat"}}
    </a>
    <a class="item {{#if (eq activeTab 'bio')}}active{{/if}}" data-action="switchTab" data-tab="bio">
      <i class="fas fa-book-dead"></i> {{localize "NORETURN.Sheet.Tabs.Bio"}}
    </a>
  </nav>

  <section class="sheet-body">
    <!-- TAB 1: ZONEN-WERTE & TUNING (1st_Edition_NoReturn-Robotikbogen.pdf) -->
    {{#if (eq activeTab "zones")}}
      <div class="tab-panel active">
        <!-- Overview of Values per Zone (Übersicht der Werte je Zone + All over Attribut) -->
        <div class="nr-card">
          <h2 class="nr-section-title">{{localize "NORETURN.Robotics.ValuesHeader"}}</h2>
          <table class="nr-table robot-zones-table">
            <thead>
              <tr>
                <th>{{localize "NORETURN.Health.Zone"}}</th>
                <th>{{localize "NORETURN.Robotics.Model"}}</th>
                <th>{{localize "NORETURN.Robotics.DesignType"}}</th>
                <th>{{localize "NORETURN.Attributes.geschickAbbr"}}</th>
                <th>{{localize "NORETURN.Attributes.staerkeAbbr"}}</th>
                <th>{{localize "NORETURN.Attributes.konstitutionAbbr"}}</th>
                <th>{{localize "NORETURN.Attributes.schnelligkeitAbbr"}}</th>
                <th>{{localize "NORETURN.Attributes.tastsinn"}}</th>
                <th>{{localize "NORETURN.Robotics.Capacity"}} ({{localize "NORETURN.Robotics.CapacityFree"}})</th>
                <th>{{localize "NORETURN.Status.Organismus"}}</th>
                <th>{{localize "NORETURN.Health.Armor"}}</th>
              </tr>
            </thead>
            <tbody>
              {{#each robotZones}}
                <tr>
                  <td><strong>{{localize this.labelKey}}</strong></td>
                  <td>
                    <select name="system.zones.{{this.code}}.model">
                      <option value="bio" {{#if (eq this.model "bio")}}selected{{/if}}>{{localize "NORETURN.Robotics.Models.bio"}}</option>
                      <option value="casual" {{#if (eq this.model "casual")}}selected{{/if}}>{{localize "NORETURN.Robotics.Models.casual"}}</option>
                      <option value="work" {{#if (eq this.model "work")}}selected{{/if}}>{{localize "NORETURN.Robotics.Models.work"}}</option>
                      <option value="hightech" {{#if (eq this.model "hightech")}}selected{{/if}}>{{localize "NORETURN.Robotics.Models.hightech"}}</option>
                      <option value="android" {{#if (eq this.model "android")}}selected{{/if}}>{{localize "NORETURN.Robotics.Models.android"}}</option>
                      <option value="military" {{#if (eq this.model "military")}}selected{{/if}}>{{localize "NORETURN.Robotics.Models.military"}}</option>
                    </select>
                  </td>
                  <td>
                    <input type="text" name="system.zones.{{this.code}}.design" value="{{this.design}}" />
                  </td>
                  <td class="center">
                    <button type="button" class="nr-chip-roll" data-action="rollZoneStat" data-zone="{{this.code}}" data-stat="geschick">
                      {{this.values.geschick}}W
                    </button>
                  </td>
                  <td class="center">
                    <button type="button" class="nr-chip-roll" data-action="rollZoneStat" data-zone="{{this.code}}" data-stat="staerke">
                      {{this.values.staerke}}W
                    </button>
                  </td>
                  <td class="center">
                    <button type="button" class="nr-chip-roll" data-action="rollZoneStat" data-zone="{{this.code}}" data-stat="konstitution">
                      {{this.values.konstitution}}W
                    </button>
                  </td>
                  <td class="center">
                    <button type="button" class="nr-chip-roll" data-action="rollZoneStat" data-zone="{{this.code}}" data-stat="schnelligkeit">
                      {{this.values.schnelligkeit}}W
                    </button>
                  </td>
                  <td class="center">{{this.values.tastsinn}}W</td>
                  <td class="center">{{this.values.kapazitaetFrei}} / {{this.values.kapazitaetMax}}</td>
                  <td class="center">-{{this.values.organismus}}</td>
                  <td class="center">{{this.values.panzerung}} ({{this.values.materialCategory}})</td>
                </tr>
              {{/each}}
            </tbody>
            <tfoot>
              <tr class="all-over-row">
                <td colspan="3"><strong>{{localize "NORETURN.Attributes.AllOverHeader"}} (Ø / 11)</strong></td>
                <td class="center">
                  <button type="button" class="nr-roll-btn" data-action="rollAllOver" data-stat="geschick">
                    <strong>{{system.allOver.geschick}}W</strong>
                  </button>
                </td>
                <td class="center">
                  <button type="button" class="nr-roll-btn" data-action="rollAllOver" data-stat="staerke">
                    <strong>{{system.allOver.staerke}}W</strong>
                  </button>
                </td>
                <td class="center">
                  <button type="button" class="nr-roll-btn" data-action="rollAllOver" data-stat="konstitution">
                    <strong>{{system.allOver.konstitution}}W</strong>
                  </button>
                </td>
                <td class="center">
                  <button type="button" class="nr-roll-btn" data-action="rollAllOver" data-stat="schnelligkeit">
                    <strong>{{system.allOver.schnelligkeit}}W</strong>
                  </button>
                </td>
                <td class="center">
                  <button type="button" class="nr-roll-btn" data-action="rollAllOver" data-stat="tastsinn">
                    <strong>{{system.allOver.tastsinn}}W</strong>
                  </button>
                </td>
                <td class="center">–</td>
                <td class="center"><strong>-{{system.allOver.summeOrganismusverlust}}</strong></td>
                <td class="center">–</td>
              </tr>
            </tfoot>
          </table>
        </div>

        <!-- Stufen Upgrades je Zone (Tuning) -->
        <div class="nr-card">
          <h2 class="nr-section-title">{{localize "NORETURN.Robotics.UpgradesHeader"}}</h2>
          <table class="nr-table tuning-table">
            <thead>
              <tr>
                <th>{{localize "NORETURN.Health.Zone"}}</th>
                <th>{{localize "NORETURN.Attributes.geschick"}} (+1 / 0,5 Kap.)</th>
                <th>{{localize "NORETURN.Attributes.staerke"}} (+1 / 0,25 Kap.)</th>
                <th>{{localize "NORETURN.Attributes.konstitution"}} (+1 / 0,25 Kap.)</th>
                <th>{{localize "NORETURN.Attributes.schnelligkeit"}} (+1 / 0,5 Kap.)</th>
                <th>{{localize "NORETURN.Attributes.tastsinn"}} (+3 / 0,25 Kap.)</th>
                <th>{{localize "NORETURN.Health.Armor"}} (+5p. / 0,5 Kap.)</th>
              </tr>
            </thead>
            <tbody>
              {{#each robotZones}}
                <tr>
                  <td><strong>{{localize this.labelKey}}</strong></td>
                  <td><input type="number" name="system.zones.{{this.code}}.upgrades.geschick" value="{{this.upgrades.geschick}}" min="0" /></td>
                  <td><input type="number" name="system.zones.{{this.code}}.upgrades.staerke" value="{{this.upgrades.staerke}}" min="0" /></td>
                  <td><input type="number" name="system.zones.{{this.code}}.upgrades.konstitution" value="{{this.upgrades.konstitution}}" min="0" /></td>
                  <td><input type="number" name="system.zones.{{this.code}}.upgrades.schnelligkeit" value="{{this.upgrades.schnelligkeit}}" min="0" /></td>
                  <td><input type="number" name="system.zones.{{this.code}}.upgrades.tastsinn" value="{{this.upgrades.tastsinn}}" min="0" /></td>
                  <td><input type="number" name="system.zones.{{this.code}}.upgrades.panzerung" value="{{this.upgrades.panzerung}}" min="0" /></td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    {{/if}}

    <!-- TAB 2: EINBAUTEN & CYBERSENSE (WAHRNEHMUNG) -->
    {{#if (eq activeTab "modules")}}
      <div class="tab-panel active">
        <div class="nr-two-col">
          <!-- Wahrnehmung / Cybersense Box -->
          <div class="nr-card">
            <h2 class="nr-section-title">{{localize "NORETURN.Senses.Header"}}</h2>
            <table class="nr-table senses-table">
              <thead>
                <tr>
                  <th>{{localize "NORETURN.Attributes.wahrnehmung"}}</th>
                  <th>{{localize "NORETURN.Attributes.Base"}}</th>
                  <th>{{localize "NORETURN.Senses.CybersenseStufe"}} (+2)</th>
                  <th>{{localize "NORETURN.Attributes.Overall"}}</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>{{localize "NORETURN.Senses.Sehen"}}</strong></td>
                  <td><input type="number" name="system.wahrnehmung.sehen.base" value="{{system.wahrnehmung.sehen.base}}" min="0" /></td>
                  <td><input type="number" name="system.wahrnehmung.sehen.cybersenseStufe" value="{{system.wahrnehmung.sehen.cybersenseStufe}}" min="0" /></td>
                  <td class="pool-cell"><strong>{{system.wahrnehmung.sehen.total}}W6</strong></td>
                  <td><button type="button" class="nr-roll-btn" data-action="rollSense" data-sense="sehen"><i class="fas fa-eye"></i></button></td>
                </tr>
                <tr>
                  <td><strong>{{localize "NORETURN.Senses.Hoeren"}}</strong></td>
                  <td><input type="number" name="system.wahrnehmung.hoeren.base" value="{{system.wahrnehmung.hoeren.base}}" min="0" /></td>
                  <td><input type="number" name="system.wahrnehmung.hoeren.cybersenseStufe" value="{{system.wahrnehmung.hoeren.cybersenseStufe}}" min="0" /></td>
                  <td class="pool-cell"><strong>{{system.wahrnehmung.hoeren.total}}W6</strong></td>
                  <td><button type="button" class="nr-roll-btn" data-action="rollSense" data-sense="hoeren"><i class="fas fa-ear-listen"></i></button></td>
                </tr>
                <tr>
                  <td><strong>{{localize "NORETURN.Senses.Riechen"}}</strong></td>
                  <td><input type="number" name="system.wahrnehmung.riechen.base" value="{{system.wahrnehmung.riechen.base}}" min="0" /></td>
                  <td><input type="number" name="system.wahrnehmung.riechen.cybersenseStufe" value="{{system.wahrnehmung.riechen.cybersenseStufe}}" min="0" /></td>
                  <td class="pool-cell"><strong>{{system.wahrnehmung.riechen.total}}W6</strong></td>
                  <td><button type="button" class="nr-roll-btn" data-action="rollSense" data-sense="riechen"><i class="fas fa-wind"></i></button></td>
                </tr>
                <tr>
                  <td><strong>{{localize "NORETURN.Senses.Schmecken"}}</strong></td>
                  <td><input type="number" name="system.wahrnehmung.schmecken.base" value="{{system.wahrnehmung.schmecken.base}}" min="0" /></td>
                  <td><input type="number" name="system.wahrnehmung.schmecken.cybersenseStufe" value="{{system.wahrnehmung.schmecken.cybersenseStufe}}" min="0" /></td>
                  <td class="pool-cell"><strong>{{system.wahrnehmung.schmecken.total}}W6</strong></td>
                  <td><button type="button" class="nr-roll-btn" data-action="rollSense" data-sense="schmecken"><i class="fas fa-utensils"></i></button></td>
                </tr>
                <tr>
                  <td><strong>{{localize "NORETURN.Senses.TastsinnAllOver"}}</strong></td>
                  <td colspan="2" class="center">Ø 11 Zonen</td>
                  <td class="pool-cell"><strong>{{system.wahrnehmung.tastsinnAllOver}}W6</strong></td>
                  <td><button type="button" class="nr-roll-btn" data-action="rollSense" data-sense="tastsinn"><i class="fas fa-hand"></i></button></td>
                </tr>
              </tbody>
              <tfoot>
                <tr class="all-over-row">
                  <td colspan="3"><strong>{{localize "NORETURN.Senses.AllOverWahrnehmung"}} (Ø / 5)</strong></td>
                  <td class="pool-cell"><strong>{{system.wahrnehmung.allOverWahrnehmung}}W6</strong></td>
                  <td><button type="button" class="nr-roll-btn" data-action="rollSense" data-sense="allOver"><i class="fas fa-dice-d6"></i></button></td>
                </tr>
              </tfoot>
            </table>
          </div>

          <!-- Einbauten + Zone -->
          <div class="nr-card">
            <div class="nr-section-header">
              <h2 class="nr-section-title">{{localize "NORETURN.Robotics.ModulesHeader"}}</h2>
              <button type="button" class="nr-btn small" data-action="createItem" data-type="robotModule">
                <i class="fas fa-plus"></i> {{localize "NORETURN.Inventory.AddCyberware"}}
              </button>
            </div>

            <table class="nr-table modules-table">
              <thead>
                <tr>
                  <th>{{localize "TYPES.Item.robotModule"}}</th>
                  <th>{{localize "NORETURN.Health.Zone"}}</th>
                  <th>{{localize "NORETURN.Robotics.Capacity"}}</th>
                  <th>{{localize "NORETURN.Status.Organismus"}}</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {{#each modules}}
                  <tr data-item-id="{{this.id}}">
                    <td><a data-action="editItem"><strong>{{this.name}}</strong></a></td>
                    <td>{{this.system.targetZone}} ({{this.system.zone}})</td>
                    <td class="center">{{this.system.capacityCost}}</td>
                    <td class="center">-{{this.system.organismusCost}}</td>
                    <td class="actions-cell">
                      <button type="button" class="nr-icon-btn" data-action="editItem"><i class="fas fa-edit"></i></button>
                      <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    {{/if}}

    <!-- TAB 3: COMBAT, DAMAGE & SKILLS -->
    {{#if (eq activeTab "combat")}}
      <div class="tab-panel active">
        <div class="nr-card">
          <h2 class="nr-section-title">{{localize "NORETURN.Health.Header"}}</h2>
          <table class="nr-table hitzones-table">
            <thead>
              <tr>
                <th>{{localize "NORETURN.Health.Zone"}}</th>
                <th>{{localize "NORETURN.Health.Damage"}}</th>
                <th>{{localize "NORETURN.Health.MaxHP"}}</th>
                <th>{{localize "NORETURN.Health.Armor"}}</th>
                <th>{{localize "NORETURN.Health.Penalty"}}</th>
                <th>{{localize "NORETURN.Health.RollSoak"}}</th>
              </tr>
            </thead>
            <tbody>
              {{#each robotZones}}
                <tr>
                  <td><strong>{{localize this.labelKey}}</strong></td>
                  <td><input type="number" name="system.zones.{{this.code}}.health.damage" value="{{this.health.damage}}" min="0" max="{{this.health.max}}" /></td>
                  <td class="center">{{this.health.max}}</td>
                  <td class="center">{{this.values.panzerung}} ({{this.values.materialCategory}})</td>
                  <td class="center penalty-cell">{{#if (gt this.health.penalty 0)}}-{{this.health.penalty}}W6{{else}}0{{/if}}</td>
                  <td class="center">
                    <button type="button" class="nr-roll-btn" data-action="rollSoak" data-zone="{{this.code}}">
                      <i class="fas fa-shield-halved"></i>
                    </button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <div class="nr-two-col">
          <!-- Weapons -->
          <div class="nr-card">
            <div class="nr-section-header">
              <h2 class="nr-section-title">{{localize "NORETURN.Combat.WeaponsHeader"}}</h2>
              <button type="button" class="nr-btn small" data-action="createItem" data-type="weapon">
                <i class="fas fa-plus"></i> {{localize "NORETURN.Combat.AddWeapon"}}
              </button>
            </div>
            <table class="nr-table">
              <thead>
                <tr>
                  <th>{{localize "NORETURN.Combat.WeaponName"}}</th>
                  <th>{{localize "NORETURN.Combat.Damage"}}</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {{#each weapons}}
                  <tr data-item-id="{{this.id}}">
                    <td><a data-action="editItem"><strong>{{this.name}}</strong></a></td>
                    <td>{{this.system.damageFormula}}</td>
                    <td class="actions-cell">
                      <button type="button" class="nr-roll-btn" data-action="rollWeapon"><i class="fas fa-crosshairs"></i></button>
                      <button type="button" class="nr-roll-btn" data-action="rollDamage"><i class="fas fa-burst"></i></button>
                      <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>

          <!-- Skills -->
          <div class="nr-card">
            <div class="nr-section-header">
              <h2 class="nr-section-title">{{localize "NORETURN.Skills.Header"}}</h2>
              <button type="button" class="nr-btn small" data-action="createItem" data-type="skill">
                <i class="fas fa-plus"></i> {{localize "NORETURN.Skills.AddSkill"}}
              </button>
            </div>
            <table class="nr-table">
              <thead>
                <tr>
                  <th>{{localize "NORETURN.Skills.Name"}}</th>
                  <th>{{localize "NORETURN.Skills.Level"}}</th>
                  <th>{{localize "NORETURN.Skills.Pool"}}</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {{#each skills}}
                  <tr data-item-id="{{this.id}}">
                    <td><a data-action="editItem"><strong>{{this.name}}</strong></a></td>
                    <td class="center">{{this.system.level}}</td>
                    <td class="pool-cell"><strong>{{this.system.pool}}W6</strong></td>
                    <td class="actions-cell">
                      <button type="button" class="nr-roll-btn" data-action="rollSkill"><i class="fas fa-dice-d6"></i></button>
                      <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    {{/if}}

    <!-- TAB 4: NOTES -->
    {{#if (eq activeTab "bio")}}
      <div class="tab-panel active">
        <div class="nr-card">
          <h2 class="nr-section-title">{{localize "NORETURN.Traits.Notes"}}</h2>
          <textarea class="nr-notes-area" name="system.notes" rows="10">{{system.notes}}</textarea>
        </div>
      </div>
    {{/if}}
  </section>
</div>
