<div class="noreturn-sheet character-sheet-root">
  <!-- Sheet Header -->
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}" />
    <div class="header-fields">
      <div class="header-top-row">
        <h1 class="charname">
          <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'NORETURN.Personal.Name'}}" />
        </h1>
        <div class="header-quick-actions">
          <button type="button" class="nr-btn" data-action="rollInitiative">
            <i class="fas fa-bolt"></i> {{localize "NORETURN.Combat.RollInitiative"}}
          </button>
          <button type="button" class="nr-btn" data-action="rollHitZone">
            <i class="fas fa-crosshairs"></i> {{localize "NORETURN.Health.RollHitZone"}}
          </button>
        </div>
      </div>

      <!-- Personal Metadata Grid (from Charakterbogen 1.2 DE) -->
      <div class="personal-grid">
        <label>
          <span>{{localize "NORETURN.Personal.Spezies"}}</span>
          <div class="nr-species-select-row">
            <select name="system.personal.spezies" class="nr-species-select">
              {{#each speciesOptions}}
                <option value="{{this}}" {{#if (eq ../system.personal.spezies this)}}selected{{/if}}>{{this}}</option>
              {{/each}}
            </select>
            <button type="button" class="nr-icon-btn nr-species-apply-btn" data-action="applySpeciesPreset" title="{{localize 'NORETURN.Species.ApplyPreset'}}">
              <i class="fas fa-dna"></i>
            </button>
          </div>
        </label>
        <label>
          <span>{{localize "NORETURN.Personal.Berufung"}}</span>
          <input type="text" name="system.personal.berufung" value="{{system.personal.berufung}}" />
        </label>
        <label>
          <span>{{localize "NORETURN.Personal.Geschlecht"}}</span>
          <input type="text" name="system.personal.geschlecht" value="{{system.personal.geschlecht}}" />
        </label>
        <label>
          <span>{{localize "NORETURN.Personal.Alter"}}</span>
          <input type="number" name="system.personal.alter" value="{{system.personal.alter}}" />
        </label>
        <label>
          <span>{{localize "NORETURN.Personal.Groesse"}}</span>
          <input type="text" name="system.personal.groesse" value="{{system.personal.groesse}}" />
        </label>
        <label>
          <span>{{localize "NORETURN.Personal.Gewicht"}}</span>
          <input type="text" name="system.personal.gewicht" value="{{system.personal.gewicht}}" />
        </label>
        <label>
          <span>{{localize "NORETURN.Personal.Haarfarbe"}}</span>
          <input type="text" name="system.personal.haarfarbe" value="{{system.personal.haarfarbe}}" />
        </label>
        <label>
          <span>{{localize "NORETURN.Personal.Augenfarbe"}}</span>
          <input type="text" name="system.personal.augenfarbe" value="{{system.personal.augenfarbe}}" />
        </label>
        <label>
          <span>{{localize "NORETURN.Personal.Hautfarbe"}}</span>
          <input type="text" name="system.personal.hautfarbe" value="{{system.personal.hautfarbe}}" />
        </label>
      </div>

      {{#if speciesSummary}}
        <div class="nr-species-banner">
          <i class="fas fa-dna"></i>
          <strong>{{system.personal.spezies}}:</strong> {{speciesSummary.specialRules}}
        </div>
      {{/if}}

      <!-- Status Banners -->
      {{#if isOrganismCritical}}
        <div class="nr-alert danger">
          <i class="fas fa-triangle-exclamation"></i>
          {{localize "NORETURN.Status.OrganismCriticalWarning"}} ({{system.status.organismus.current}} / {{system.status.organismus.max}})
        </div>
      {{/if}}
      {{#if isUnconscious}}
        <div class="nr-alert danger"><i class="fas fa-skull"></i> {{localize "NORETURN.Health.UnconsciousWarning"}}</div>
      {{else if isImmobilized}}
        <div class="nr-alert warning"><i class="fas fa-crutch"></i> {{localize "NORETURN.Health.ImmobilizedWarning"}}</div>
      {{/if}}
    </div>
  </header>

  <!-- Navigation Tabs -->
  <nav class="sheet-tabs tabs" role="tablist">
    <a class="item {{#if (eq activeTab 'overview')}}active{{/if}}" data-action="switchTab" data-tab="overview">
      <i class="fas fa-id-card"></i> {{localize "NORETURN.Sheet.Tabs.Overview"}}
    </a>
    <a class="item {{#if (eq activeTab 'skills')}}active{{/if}}" data-action="switchTab" data-tab="skills">
      <i class="fas fa-dice-d6"></i> {{localize "NORETURN.Sheet.Tabs.Skills"}}
    </a>
    {{#if isPsiCapable}}
      <a class="item {{#if (eq activeTab 'psi')}}active{{/if}}" data-action="switchTab" data-tab="psi">
        <i class="fas fa-brain"></i> {{localize "NORETURN.Sheet.Tabs.Psi"}}
      </a>
    {{/if}}
    <a class="item {{#if (eq activeTab 'combat')}}active{{/if}}" data-action="switchTab" data-tab="combat">
      <i class="fas fa-crosshairs"></i> {{localize "NORETURN.Sheet.Tabs.Combat"}}
    </a>
    <a class="item {{#if (eq activeTab 'inventory')}}active{{/if}}" data-action="switchTab" data-tab="inventory">
      <i class="fas fa-suitcase"></i> {{localize "NORETURN.Sheet.Tabs.Inventory"}}
    </a>
    <a class="item {{#if (eq activeTab 'augmentation')}}active{{/if}}" data-action="switchTab" data-tab="augmentation">
      <i class="fas fa-microchip"></i> {{localize "NORETURN.Sheet.Tabs.Augmentation"}}
    </a>
    <a class="item {{#if (eq activeTab 'bio')}}active{{/if}}" data-action="switchTab" data-tab="bio">
      <i class="fas fa-dna"></i> {{localize "NORETURN.Sheet.Tabs.Bio"}}
    </a>
  </nav>

  <!-- Sheet Body -->
  <section class="sheet-body">
    <!-- TAB 1: OVERVIEW & ATTRIBUTES -->
    {{#if (eq activeTab "overview")}}
      <div class="tab-panel active">
        <div class="nr-two-col">
          <!-- Left Column: Primary, Secondary & Special Attributes -->
          <div class="nr-card">
            <h2 class="nr-section-title">{{localize "NORETURN.Attributes.PrimaryHeader"}}</h2>
            <table class="nr-table attr-table">
              <thead>
                <tr>
                  <th>{{localize "NORETURN.Skills.Attribute"}}</th>
                  <th>{{localize "NORETURN.Attributes.Base"}}</th>
                  <th>{{localize "NORETURN.Attributes.Mod"}}</th>
                  <th>{{localize "NORETURN.Attributes.Overall"}}</th>
                  <th>{{localize "NORETURN.Attributes.AlphaBio"}}</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {{#each primaryAttributes}}
                  <tr>
                    <td>
                      <strong>{{localize this.labelKey}}</strong>
                      <small class="muted">({{localize this.abbrKey}})</small>
                    </td>
                    <td>
                      <input type="number" name="system.attributes.primary.{{this.key}}.base" value="{{this.base}}" min="1" max="{{this.maxLimit}}" title="Spezies-Max: {{this.maxLimit}}" />
                    </td>
                    <td>
                      <input type="number" name="system.attributes.primary.{{this.key}}.mod" value="{{this.mod}}" />
                    </td>
                    <td class="pool-cell" data-tooltip="{{this.poolTooltip}}" title="{{this.poolTooltip}}"><strong>{{this.overall}}W6</strong></td>
                    <td class="center">
                      <input type="checkbox" name="system.attributes.primary.{{this.key}}.alphaBio" {{checked this.alphaBio}} />
                    </td>
                    <td class="center">
                      <button type="button" class="nr-roll-btn" data-action="rollAttribute" data-attribute="{{this.key}}">
                        <i class="fas fa-dice-d6"></i>
                      </button>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>

            <h2 class="nr-section-title">{{localize "NORETURN.Attributes.SecondaryHeader"}}</h2>
            <table class="nr-table attr-table">
              <thead>
                <tr>
                  <th>{{localize "NORETURN.Skills.Attribute"}}</th>
                  <th>{{localize "NORETURN.Attributes.Base"}}</th>
                  <th>{{localize "NORETURN.Attributes.Mod"}}</th>
                  <th>{{localize "NORETURN.Attributes.Overall"}}</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {{#each secondaryAttributes}}
                  <tr>
                    <td>
                      <strong>{{localize this.labelKey}}</strong>
                      <small class="muted">({{localize this.abbrKey}})</small>
                    </td>
                    <td>
                      <input type="number" name="system.attributes.secondary.{{this.key}}.base" value="{{this.base}}" min="0" max="{{this.maxLimit}}" title="Spezies-Max: {{this.maxLimit}}" />
                    </td>
                    <td>
                      <input type="number" name="system.attributes.secondary.{{this.key}}.mod" value="{{this.mod}}" />
                    </td>
                    <td class="pool-cell" data-tooltip="{{this.poolTooltip}}" title="{{this.poolTooltip}}"><strong>{{this.total}}</strong></td>
                    <td class="center">
                      {{#if this.rollable}}
                        <button type="button" class="nr-roll-btn" data-action="rollAttribute" data-attribute="{{this.key}}">
                          <i class="fas fa-dice-d6"></i>
                        </button>
                      {{/if}}
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>

            <h2 class="nr-section-title">{{localize "NORETURN.Attributes.SpecialHeader"}}</h2>
            <div class="nr-stat-grid">
              <label>
                <span>{{localize "NORETURN.Attributes.adrenalin"}} ({{localize "NORETURN.Attributes.Base"}})</span>
                <input type="number" name="system.attributes.special.adrenalin.stufe" value="{{system.attributes.special.adrenalin.stufe}}" min="0" />
              </label>
              <label>
                <span>{{localize "NORETURN.Attributes.adrenalin"}} ({{localize "NORETURN.Attributes.Pool"}})</span>
                <input type="number" name="system.attributes.special.adrenalin.pool" value="{{system.attributes.special.adrenalin.pool}}" min="0" />
              </label>
            </div>
          </div>

          <!-- Right Column: Condition, Organism, Psyche, Fate Points & Economy -->
          <div class="nr-card">
            <h2 class="nr-section-title">{{localize "NORETURN.Status.Header"}}</h2>
            <div class="nr-stat-grid">
              <label>
                <span>{{localize "NORETURN.Status.Bekanntheit"}}</span>
                <input type="number" name="system.status.bekanntheit" value="{{system.status.bekanntheit}}" min="1" max="100" />
              </label>
              <label>
                <span>{{localize "NORETURN.Status.Ruf"}}</span>
                <input type="number" name="system.status.ruf" value="{{system.status.ruf}}" />
              </label>
              <label class="full-span">
                <span>
                  {{localize "NORETURN.Status.Organismus"}} (Max {{system.status.organismus.max}} | {{localize "NORETURN.Status.CyberwareCost"}}: -{{system.status.organismus.cyberwareCost}})
                </span>
                <div class="nr-organism-bar-row">
                  <input type="number" name="system.status.organismus.max" value="{{system.status.organismus.max}}" min="0" max="100" title="Basis / Max Organismus" />
                  <span class="nr-organism-deduction" title="{{localize 'NORETURN.Status.CyberwareCost'}}">
                    <i class="fas fa-microchip"></i> -{{system.status.organismus.cyberwareCost}}
                  </span>
                  <span class="nr-organism-current {{#if isOrganismCritical}}critical{{/if}}">
                    {{localize "NORETURN.Status.Aktuell"}}: <strong>{{system.status.organismus.current}}</strong>
                  </span>
                </div>
              </label>
              <label>
                <span>{{localize "NORETURN.Status.Psyche"}} (Max {{system.status.psyche.max}})</span>
                <input type="number" name="system.status.psyche.value" value="{{system.status.psyche.value}}" min="0" max="100" />
              </label>
              <label>
                <span>{{localize "NORETURN.Status.Infektionsresistenz"}}</span>
                <div class="flexrow">
                  <input type="text" name="system.status.infektionsresistenz" value="{{system.status.infektionsresistenz}}" />
                  <button type="button" class="nr-roll-btn" data-action="rollInfection">
                    <i class="fas fa-biohazard"></i>
                  </button>
                </div>
              </label>
              <label>
                <span>{{localize "NORETURN.Status.Tragkraft"}}</span>
                <input type="number" value="{{system.status.tragkraft}}" disabled />
              </label>
              <label>
                <span>{{localize "NORETURN.Status.Regeneration"}} ({{localize "NORETURN.Status.RegenSpeed"}})</span>
                <input type="number" name="system.status.regeneration.geschwindigkeit" value="{{system.status.regeneration.geschwindigkeit}}" min="0" />
              </label>
              <label>
                <span>{{localize "NORETURN.Status.Regeneration"}} ({{localize "NORETURN.Status.RegenPool"}})</span>
                <input type="number" name="system.status.regeneration.pool" value="{{system.status.regeneration.pool}}" min="0" />
              </label>
            </div>

            <div class="nr-stat-grid three-col">
              <label>
                <span>{{localize "NORETURN.Status.Leiden1"}}</span>
                <input type="text" name="system.status.organismus.leiden1" value="{{system.status.organismus.leiden1}}" />
              </label>
              <label>
                <span>{{localize "NORETURN.Status.Leiden2"}}</span>
                <input type="text" name="system.status.organismus.leiden2" value="{{system.status.organismus.leiden2}}" />
              </label>
              <label>
                <span>{{localize "NORETURN.Status.Leiden3"}}</span>
                <input type="text" name="system.status.organismus.leiden3" value="{{system.status.organismus.leiden3}}" />
              </label>
            </div>

            <hr />

            <div class="nr-stat-grid">
              <label>
                <span>{{localize "NORETURN.Status.Erfahrung"}} ({{localize "NORETURN.Status.Gesamt"}})</span>
                <input type="number" name="system.status.erfahrung.gesamt" value="{{system.status.erfahrung.gesamt}}" min="0" />
              </label>
              <label>
                <span>{{localize "NORETURN.Status.Erfahrung"}} ({{localize "NORETURN.Status.Aktuell"}})</span>
                <input type="number" name="system.status.erfahrung.aktuell" value="{{system.status.erfahrung.aktuell}}" min="0" />
              </label>
              <label>
                <span>{{localize "NORETURN.Status.Justicepoints"}} ({{localize "NORETURN.Status.Gesamt"}})</span>
                <input type="number" name="system.status.justicepoints.gesamt" value="{{system.status.justicepoints.gesamt}}" min="0" />
              </label>
              <label>
                <span>{{localize "NORETURN.Status.Justicepoints"}} ({{localize "NORETURN.Status.Aktuell"}})</span>
                <input type="number" name="system.status.justicepoints.aktuell" value="{{system.status.justicepoints.aktuell}}" min="0" />
              </label>
              <label>
                <span>{{localize "NORETURN.Status.Chaospoints"}} ({{localize "NORETURN.Status.Gesamt"}})</span>
                <input type="number" name="system.status.chaospoints.gesamt" value="{{system.status.chaospoints.gesamt}}" min="0" />
              </label>
              <label>
                <span>{{localize "NORETURN.Status.Chaospoints"}} ({{localize "NORETURN.Status.Aktuell"}})</span>
                <input type="number" name="system.status.chaospoints.aktuell" value="{{system.status.chaospoints.aktuell}}" min="0" />
              </label>
              <label class="full-span">
                <span>{{localize "NORETURN.Status.Bargeld"}}</span>
                <input type="number" name="system.status.bargeld" value="{{system.status.bargeld}}" min="0" />
              </label>
            </div>
          </div>
        </div>
      </div>
    {{/if}}

    <!-- TAB 2: SKILLS, STYLESKILLS & CONDITIONS -->
    {{#if (eq activeTab "skills")}}
      <div class="tab-panel active">
        <!-- Sub-Tab Navigation: Standardfertigkeiten, Styleskills & Krankheiten/Gifte -->
        <div class="nr-subtabs">
          <button type="button" class="nr-subtab-btn {{#if (eq activeSkillSubtab 'standard')}}active{{/if}}" data-action="switchSkillSubtab" data-subtab="standard">
            <i class="fas fa-list-check"></i> {{localize "NORETURN.Skills.StandardHeader"}} ({{skills.length}})
          </button>
          <button type="button" class="nr-subtab-btn {{#if (eq activeSkillSubtab 'styleskills')}}active{{/if}}" data-action="switchSkillSubtab" data-subtab="styleskills">
            <i class="fas fa-star"></i> {{localize "NORETURN.StyleSkills.Header"}} ({{styleSkills.length}})
          </button>
          <button type="button" class="nr-subtab-btn {{#if (eq activeSkillSubtab 'conditions')}}active{{/if}}" data-action="switchSkillSubtab" data-subtab="conditions">
            <i class="fas fa-biohazard"></i> {{localize "NORETURN.Conditions.Header"}} ({{conditions.length}})
          </button>
        </div>

        {{#if (eq activeSkillSubtab "standard")}}
          <div class="nr-card">
            <div class="nr-section-header">
              <h2 class="nr-section-title">{{localize "NORETURN.Skills.StandardHeader"}}</h2>
              <button type="button" class="nr-btn small" data-action="createItem" data-type="skill">
                <i class="fas fa-plus"></i> {{localize "NORETURN.Skills.AddSkill"}}
              </button>
            </div>

            <table class="nr-table skills-table">
              <thead>
                <tr>
                  <th class="col-skill-name">{{localize "NORETURN.Skills.Name"}}</th>
                  <th class="col-skill-attr">{{localize "NORETURN.Skills.Attribute"}}</th>
                  <th class="col-skill-zone">{{localize "NORETURN.Skills.ZoneRef"}}</th>
                  <th class="col-skill-level skill-level">{{localize "NORETURN.Skills.Level"}}</th>
                  <th class="col-skill-mod skill-mod">{{localize "NORETURN.Skills.Mod"}}</th>
                  <th class="col-skill-pool skill-pool">{{localize "NORETURN.Skills.Pool"}}</th>
                  <th class="col-skill-actions skill-actions"></th>
                </tr>
              </thead>
              <tbody>
                {{#each skills}}
                  <tr data-item-id="{{this.id}}">
                    <td class="col-skill-name">
                      <a data-action="editItem"><strong>{{this.name}}</strong></a>
                    </td>
                    <td class="col-skill-attr">
                      {{#if this.system.attribute}}
                        {{localize (concat "NORETURN.Attributes." this.system.attribute)}}
                      {{else}}
                        –
                      {{/if}}
                    </td>
                    <td class="col-skill-zone">{{this.system.zoneReference}}</td>
                    <td class="center nr-stepper-cell col-skill-level skill-level">
                      <div class="nr-inline-stepper">
                        <button type="button" class="nr-step-btn" data-action="stepItemNumeric" data-field="system.level" data-step="-1" title="-1 Stufe">−</button>
                        <input type="number" class="nr-inline-item-input" data-item-id="{{this.id}}" data-field="system.level" value="{{this.system.level}}" min="0" />
                        <button type="button" class="nr-step-btn" data-action="stepItemNumeric" data-field="system.level" data-step="1" title="+1 Stufe">+</button>
                      </div>
                    </td>
                    <td class="center nr-stepper-cell col-skill-mod skill-mod">
                      <div class="nr-inline-stepper">
                        <button type="button" class="nr-step-btn" data-action="stepItemNumeric" data-field="system.mod" data-step="-1" title="-1 Mod.">−</button>
                        <input type="number" class="nr-inline-item-input" data-item-id="{{this.id}}" data-field="system.mod" value="{{this.system.mod}}" />
                        <button type="button" class="nr-step-btn" data-action="stepItemNumeric" data-field="system.mod" data-step="1" title="+1 Mod.">+</button>
                      </div>
                      {{#if this.system.itemBonusMod}}
                        <small class="nr-item-mod-badge" title="Automatischer Bonus aus Spezies/Mutation/Styleskills/Drogen">({{#if (gt this.system.itemBonusMod 0)}}+{{/if}}{{this.system.itemBonusMod}})</small>
                      {{/if}}
                    </td>
                    <td class="pool-cell col-skill-pool skill-pool" data-tooltip="{{this.system.poolTooltip}}" title="{{this.system.poolTooltip}}"><strong>{{this.system.pool}}W6</strong></td>
                    <td class="actions-cell col-skill-actions skill-actions">
                      <button type="button" class="nr-roll-btn" data-action="rollSkill">
                        <i class="fas fa-dice-d6"></i>
                      </button>
                      <button type="button" class="nr-icon-btn" data-action="editItem">
                        <i class="fas fa-edit"></i>
                      </button>
                      <button type="button" class="nr-icon-btn danger" data-action="deleteItem">
                        <i class="fas fa-trash"></i>
                      </button>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{/if}}

        {{#if (eq activeSkillSubtab "styleskills")}}
          <div class="nr-card">
            <div class="nr-section-header">
              <h2 class="nr-section-title">{{localize "NORETURN.StyleSkills.Header"}}</h2>
              <button type="button" class="nr-btn small" data-action="createItem" data-type="styleskill">
                <i class="fas fa-plus"></i> {{localize "NORETURN.StyleSkills.AddStyleSkill"}}
              </button>
            </div>

            <table class="nr-table styleskills-table">
              <thead>
                <tr>
                  <th class="col-skill-name">{{localize "NORETURN.Skills.Name"}}</th>
                  <th class="col-skill-attr">{{localize "NORETURN.Skills.Attribute"}}</th>
                  <th class="col-skill-level skill-level">{{localize "NORETURN.Skills.Level"}}</th>
                  <th>{{localize "NORETURN.StyleSkills.PassiveBonus"}}</th>
                  <th>{{localize "NORETURN.Species.SkillModifiers"}}</th>
                  <th class="col-skill-pool skill-pool">{{localize "NORETURN.Skills.Pool"}}</th>
                  <th class="col-skill-actions skill-actions"></th>
                </tr>
              </thead>
              <tbody>
                {{#each styleSkills}}
                  <tr data-item-id="{{this.id}}">
                    <td class="col-skill-name">
                      <a data-action="editItem"><strong>{{this.name}}</strong></a>
                    </td>
                    <td class="col-skill-attr">
                      {{#if this.system.attribute}}
                        {{localize (concat "NORETURN.Attributes." this.system.attribute)}}
                      {{else}}
                        –
                      {{/if}}
                    </td>
                    <td class="center nr-stepper-cell col-skill-level skill-level">
                      <div class="nr-inline-stepper">
                        <button type="button" class="nr-step-btn" data-action="stepItemNumeric" data-field="system.level" data-step="-1" title="-1 Stufe">−</button>
                        <input type="number" class="nr-inline-item-input" data-item-id="{{this.id}}" data-field="system.level" value="{{this.system.level}}" min="1" max="{{this.system.maxLevel}}" />
                        <button type="button" class="nr-step-btn" data-action="stepItemNumeric" data-field="system.level" data-step="1" title="+1 Stufe">+</button>
                      </div>
                      <small class="muted">/ {{this.system.maxLevel}}</small>
                    </td>
                    <td>{{this.system.passiveBonus}}</td>
                    <td>{{this.system.skillModifiers}}</td>
                    <td class="pool-cell col-skill-pool skill-pool" data-tooltip="{{this.system.poolTooltip}}" title="{{this.system.poolTooltip}}"><strong>{{this.system.pool}}W6</strong></td>
                    <td class="actions-cell col-skill-actions skill-actions">
                      <button type="button" class="nr-roll-btn" data-action="rollSkill" title="{{localize 'NORETURN.StyleSkills.RollStyleSkill'}}">
                        <i class="fas fa-dice-d6"></i>
                      </button>
                      <button type="button" class="nr-icon-btn" data-action="editItem">
                        <i class="fas fa-edit"></i>
                      </button>
                      <button type="button" class="nr-icon-btn danger" data-action="deleteItem">
                        <i class="fas fa-trash"></i>
                      </button>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{/if}}

        {{#if (eq activeSkillSubtab "conditions")}}
          <!-- Krankheiten, Gifte & Trigger-System -->
          <div class="nr-card">
            <div class="nr-section-header">
              <h2 class="nr-section-title">{{localize "NORETURN.Conditions.Header"}}</h2>
              <div class="nr-inline-controls">
                <button type="button" class="nr-btn small" data-action="createItem" data-type="disease">
                  <i class="fas fa-plus"></i> {{localize "TYPES.Item.disease"}}
                </button>
                <button type="button" class="nr-btn small" data-action="createItem" data-type="toxin">
                  <i class="fas fa-plus"></i> {{localize "TYPES.Item.toxin"}}
                </button>
              </div>
            </div>

            <table class="nr-table conditions-table">
              <thead>
                <tr>
                  <th>{{localize "TYPES.Item.condition"}}</th>
                  <th>{{localize "NORETURN.Conditions.Incubation"}}</th>
                  <th>{{localize "NORETURN.Conditions.Interval"}}</th>
                  <th>{{localize "NORETURN.Conditions.Intensity"}}</th>
                  <th>{{localize "NORETURN.Conditions.DamagePenalties"}}</th>
                  <th>{{localize "NORETURN.Conditions.ResistanceRoll"}}</th>
                </tr>
              </thead>
              <tbody>
                {{#each conditions}}
                  <tr data-item-id="{{this.id}}">
                    <td>
                      <a data-action="rollCondition" title="{{localize 'NORETURN.Conditions.RollResistance'}}">
                        <strong><i class="fas fa-biohazard"></i> {{this.name}}</strong>
                      </a>
                    </td>
                    <td>{{this.system.incubationTime}}</td>
                    <td>{{this.system.testInterval}}</td>
                    <td class="center"><strong>MW {{this.system.intensity}}</strong></td>
                    <td>{{this.system.damagePerStage}} {{#if this.system.penaltiesPerStage}}({{this.system.penaltiesPerStage}}){{/if}}</td>
                    <td class="actions-cell">
                      <button type="button" class="nr-roll-btn" data-action="rollCondition" title="{{localize 'NORETURN.Conditions.RollResistance'}}">
                        <i class="fas fa-dice-d6"></i>
                      </button>
                      <button type="button" class="nr-icon-btn" data-action="editItem"><i class="fas fa-edit"></i></button>
                      <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{/if}}
      </div>
    {{/if}}

    <!-- TAB 3: PSI-SYSTEM (KRÄFTE, APPS, PYRAMIDE & FEHLSCHLAGTABELLEN) -->
    {{#if (eq activeTab "psi")}}
      <div class="tab-panel active">
        <!-- PSI Pyramid Status & Mishap Table Quick-Rollers -->
        <div class="nr-card">
          <div class="nr-section-header">
            <h2 class="nr-section-title"><i class="fas fa-sitemap"></i> {{localize "NORETURN.PSI.PyramidHeader"}}</h2>
            <div class="nr-inline-controls">
              <button type="button" class="nr-btn small" data-action="rollPsiMishap" data-tier="1">
                <i class="fas fa-dice"></i> {{localize "NORETURN.PSI.MishapTable1"}}
              </button>
              <button type="button" class="nr-btn small" data-action="rollPsiMishap" data-tier="2">
                <i class="fas fa-dice"></i> {{localize "NORETURN.PSI.MishapTable2"}}
              </button>
              <button type="button" class="nr-btn small" data-action="rollPsiMishap" data-tier="3">
                <i class="fas fa-dice"></i> {{localize "NORETURN.PSI.MishapTable3"}}
              </button>
              <button type="button" class="nr-btn small danger" data-action="rollPsiMishap" data-tier="overload">
                <i class="fas fa-bolt"></i> {{localize "NORETURN.PSI.OverloadTable"}}
              </button>
            </div>
          </div>

          <div class="nr-psi-pyramid-bar">
            <div class="pyramid-stat">
              <span class="lbl">{{localize "NORETURN.PSI.MaxHierarchyTier"}}</span>
              <span class="val">{{localize "NORETURN.PSI.Tier"}} {{psiSummary.maxHierarchyTier}}</span>
            </div>
            <div class="pyramid-stat">
              <span class="lbl">{{localize "NORETURN.PSI.Tier"}} 1 {{localize "NORETURN.PSI.Forces"}}</span>
              <span class="val">{{psiSummary.forcesByTier.[1]}}</span>
            </div>
            <div class="pyramid-stat">
              <span class="lbl">{{localize "NORETURN.PSI.Tier"}} 2 {{localize "NORETURN.PSI.Forces"}}</span>
              <span class="val">{{psiSummary.forcesByTier.[2]}}</span>
            </div>
            <div class="pyramid-stat">
              <span class="lbl">{{localize "NORETURN.PSI.Tier"}} 3 {{localize "NORETURN.PSI.Forces"}}</span>
              <span class="val">{{psiSummary.forcesByTier.[3]}}</span>
            </div>
          </div>
          <p class="nr-pyramid-hint">
            <i class="fas fa-circle-info"></i> {{localize "NORETURN.PSI.PyramidRuleHint"}}
          </p>
          <div class="nr-psi-rules-box" style="margin-top:6px;padding:8px 10px;background:rgba(15,25,30,0.65);border-left:3px solid #d4882a;border-radius:4px;font-size:0.86em;">
            <div><strong>{{localize "NORETURN.PSI.DynamicPoolHeader"}}:</strong> {{localize "NORETURN.PSI.DynamicPoolDesc"}} (Basis: Logik <strong>{{system.attributes.secondary.logik.total}}W6</strong> + Kraft-Stufe − Mali <strong>{{system.health.gesamteMali}}W6</strong>; im Würfeldialog frei wählbar bis 2× Basis-Pool bei Überanstrengung).</div>
            <div style="margin-top:3px;"><strong>{{localize "NORETURN.PSI.HierarchyOverviewHeader"}}:</strong> <strong>Stufe 1:</strong> Cryokinese, Elektrokinese, Pyrokinese, Telekinese | <strong>Stufe 2:</strong> Animakinese, Momenkinese, Photokinese, Psychokinese | <strong>Stufe 3:</strong> Biokinese, Cronokinese, Morphokinese, Technokinese.</div>
          </div>
        </div>

        <!-- PSI-Kräfte (Übergeordnete Disziplinen) -->
        <div class="nr-card">
          <div class="nr-section-header">
            <h2 class="nr-section-title">{{localize "NORETURN.PSI.ForcesHeader"}}</h2>
            <button type="button" class="nr-btn small" data-action="createItem" data-type="psiForce">
              <i class="fas fa-plus"></i> {{localize "NORETURN.PSI.AddForce"}}
            </button>
          </div>

          {{#unless psiSummary.forceHierarchyValid}}
            <div class="nr-alert danger nr-pyramid-violation" style="margin-bottom:10px;">
              <i class="fas fa-triangle-exclamation"></i>
              <div>
                <strong>{{localize "NORETURN.PSI.PyramidViolationHeader"}}:</strong> {{psiSummary.forceHierarchyWarningText}}
              </div>
            </div>
          {{/unless}}

          <table class="nr-table psi-forces-table">
            <thead>
              <tr>
                <th>{{localize "NORETURN.PSI.ForceName"}}</th>
                <th>{{localize "NORETURN.PSI.Category"}}</th>
                <th>{{localize "NORETURN.PSI.HierarchyTier"}}</th>
                <th>{{localize "NORETURN.Skills.Level"}}</th>
                <th>{{localize "NORETURN.Skills.Mod"}}</th>
                <th>{{localize "NORETURN.Skills.Pool"}}</th>
                <th>{{localize "NORETURN.PSI.Mastery"}}</th>
                <th>{{localize "NORETURN.PSI.LearnedApps"}} (S1/S2/S3)</th>
                <th>{{localize "NORETURN.PSI.PyramidStatus"}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each psiForces}}
                <tr data-item-id="{{this.id}}" class="{{#unless this.system.pyramidValid}}pyramid-locked{{/unless}}">
                  <td><a data-action="editItem"><strong>{{this.name}}</strong></a></td>
                  <td class="center">Kategorie {{this.system.psiCategory}}</td>
                  <td class="center">{{localize "NORETURN.PSI.Tier"}} {{this.system.hierarchyTier}}</td>
                  <td class="center">{{this.system.level}}</td>
                  <td class="center">{{this.system.effectiveMod}}</td>
                  <td class="pool-cell"><strong>1–{{this.system.pool}}W6</strong></td>
                  <td class="center">
                    {{#if this.system.mastery}}
                      <span class="noreturn-badge success"><i class="fas fa-crown"></i> {{localize "NORETURN.PSI.Mastery"}}</span>
                    {{else}}
                      –
                    {{/if}}
                  </td>
                  <td class="center">
                    {{this.system.appCounts.[1]}} / {{this.system.appCounts.[2]}} / {{this.system.appCounts.[3]}}
                  </td>
                  <td class="center">
                    {{#if this.system.pyramidValid}}
                      <span class="noreturn-badge success"><i class="fas fa-check"></i> OK</span>
                    {{else}}
                      <span class="noreturn-badge lethal" title="{{this.system.pyramidReason}}">
                        <i class="fas fa-triangle-exclamation"></i> {{localize "NORETURN.PSI.PyramidViolationShort"}}
                      </span>
                      <div class="muted" style="font-size:0.78em;margin-top:2px;">{{this.system.pyramidReason}}</div>
                    {{/if}}
                  </td>
                  <td class="actions-cell">
                    <button type="button" class="nr-roll-btn" data-action="rollPsiForce" title="{{localize 'NORETURN.PSI.RollForce'}}">
                      <i class="fas fa-dice-d6"></i>
                    </button>
                    <button type="button" class="nr-icon-btn" data-action="editItem"><i class="fas fa-edit"></i></button>
                    <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <!-- PSI-Apps (Konkrete Anwendungen) -->
        <div class="nr-card">
          <div class="nr-section-header">
            <h2 class="nr-section-title">{{localize "NORETURN.PSI.AppsHeader"}}</h2>
            <button type="button" class="nr-btn small" data-action="createItem" data-type="psiApp">
              <i class="fas fa-plus"></i> {{localize "NORETURN.PSI.AddApp"}}
            </button>
          </div>

          <table class="nr-table psi-apps-table">
            <thead>
              <tr>
                <th>{{localize "NORETURN.Consumables.Active"}}</th>
                <th>{{localize "NORETURN.PSI.AppName"}}</th>
                <th>{{localize "NORETURN.PSI.ForceName"}}</th>
                <th>{{localize "NORETURN.PSI.AppTier"}}</th>
                <th>{{localize "NORETURN.PSI.TargetCorridor"}}</th>
                <th>{{localize "NORETURN.PSI.Cost"}}</th>
                <th>{{localize "NORETURN.PSI.Range"}}</th>
                <th>{{localize "NORETURN.PSI.Duration"}}</th>
                <th>{{localize "NORETURN.PSI.PyramidStatus"}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each psiApps}}
                <tr data-item-id="{{this.id}}" class="{{#unless this.system.pyramidValid}}pyramid-locked{{/unless}}">
                  <td class="center">
                    <input type="checkbox" data-action="toggleActive" {{checked this.system.active}} />
                  </td>
                  <td><a data-action="editItem"><strong>{{this.name}}</strong></a></td>
                  <td>{{this.system.psiForceLabel}} (Kat. {{this.system.psiCategory}})</td>
                  <td class="center">{{localize "NORETURN.PSI.Tier"}} {{this.system.tier}}</td>
                  <td class="center"><strong>{{this.system.targetRange}}</strong></td>
                  <td class="center">{{this.system.cost}}</td>
                  <td class="center">{{this.system.range}}</td>
                  <td class="center">{{this.system.duration}}</td>
                  <td class="center">
                    {{#if this.system.pyramidValid}}
                      <span class="noreturn-badge success" title="Dynamischer Pool: 1–{{this.system.pool}}W6 (Überanstrengung bis {{this.system.maxOverloadPool}}W6)">
                        <i class="fas fa-check"></i> 1–{{this.system.pool}}W6
                      </span>
                    {{else}}
                      <span class="noreturn-badge lethal" title="{{this.system.pyramidReason}}">
                        <i class="fas fa-lock"></i> {{localize "NORETURN.PSI.Locked"}}
                      </span>
                      <div class="muted" style="font-size:0.78em;margin-top:2px;">{{this.system.pyramidReason}}</div>
                    {{/if}}
                  </td>
                  <td class="actions-cell">
                    <button type="button" class="nr-roll-btn" data-action="rollPsiApp" title="{{localize 'NORETURN.PSI.RollApp'}}">
                      <i class="fas fa-brain"></i>
                    </button>
                    <button type="button" class="nr-icon-btn" data-action="editItem"><i class="fas fa-edit"></i></button>
                    <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    {{/if}}

    <!-- TAB 4: COMBAT & HIT ZONES -->
    {{#if (eq activeTab "combat")}}
      <div class="tab-panel active">
        <!-- Hit Zones Table -->
        <div class="nr-card">
          <div class="nr-section-header">
            <h2 class="nr-section-title">{{localize "NORETURN.Health.Header"}}</h2>
            <div class="nr-inline-controls">
              <label>
                <span>{{localize "NORETURN.Health.MaxHpTier"}}:</span>
                <select name="system.health.maxHpTier" data-dtype="Number">
                  <option value="15" {{#if (eq system.health.maxHpTier 15)}}selected{{/if}}>{{localize "NORETURN.Health.Tier15"}}</option>
                  <option value="30" {{#if (eq system.health.maxHpTier 30)}}selected{{/if}}>{{localize "NORETURN.Health.Tier30"}}</option>
                  <option value="50" {{#if (eq system.health.maxHpTier 50)}}selected{{/if}}>{{localize "NORETURN.Health.Tier50"}}</option>
                  <option value="70" {{#if (eq system.health.maxHpTier 70)}}selected{{/if}}>{{localize "NORETURN.Health.Tier70"}}</option>
                  <option value="90" {{#if (eq system.health.maxHpTier 90)}}selected{{/if}}>{{localize "NORETURN.Health.Tier90"}}</option>
                </select>
              </label>
              <label>
                <span>{{localize "NORETURN.Health.SonstigeMali"}}:</span>
                <input type="number" name="system.health.sonstigeMali" value="{{system.health.sonstigeMali}}" min="0" />
              </label>
              <div class="nr-badge-stat">
                {{localize "NORETURN.Health.GesamteMali"}}: <strong>-{{system.health.gesamteMali}}W6</strong>
              </div>
            </div>
          </div>

          <table class="nr-table hitzones-table">
            <thead>
              <tr>
                <th>{{localize "NORETURN.Health.Zone"}}</th>
                <th>{{localize "NORETURN.Health.Damage"}}</th>
                <th>{{localize "NORETURN.Health.MaxHP"}}</th>
                <th>{{localize "NORETURN.Health.Armor"}}</th>
                <th>{{localize "NORETURN.Health.MaterialCategory"}}</th>
                <th>{{localize "NORETURN.Health.Penalty"}}</th>
                <th>{{localize "NORETURN.Health.RollSoak"}}</th>
              </tr>
            </thead>
            <tbody>
              {{#each hitZones}}
                <tr class="{{#if (gt this.damage 0)}}damaged{{/if}} {{#if this.lethal}}vital-zone{{/if}}">
                  <td>
                    <strong>{{localize this.labelKey}}</strong>
                    {{#if this.lethal}}
                      <span class="noreturn-badge lethal">{{localize "NORETURN.Health.Lethal"}}</span>
                    {{/if}}
                  </td>
                  <td>
                    <input type="number" name="system.health.zones.{{this.code}}.damage" value="{{this.damage}}" min="0" max="{{this.max}}" />
                  </td>
                  <td class="center">{{this.max}}</td>
                  <td class="nr-armor-rw-cell">
                    <div class="nr-armor-rw-wrap">
                      <input type="number" class="nr-armor-rw-input" name="system.health.zones.{{this.code}}.armor" value="{{this.armor}}" min="0" />
                      <span class="nr-armor-rw-total" data-tooltip="{{this.armorBreakdown}}" title="{{this.armorBreakdown}}">({{this.equippedArmor}})</span>
                    </div>
                  </td>
                  <td>
                    <select name="system.health.zones.{{this.code}}.materialCategory">
                      <option value="A" {{#if (eq this.materialCategory "A")}}selected{{/if}}>A</option>
                      <option value="B" {{#if (eq this.materialCategory "B")}}selected{{/if}}>B</option>
                      <option value="C" {{#if (eq this.materialCategory "C")}}selected{{/if}}>C</option>
                    </select>
                  </td>
                  <td class="center penalty-cell">
                    {{#if (gt this.penalty 0)}}-{{this.penalty}}W6{{else}}0{{/if}}
                  </td>
                  <td class="center">
                    <button type="button" class="nr-roll-btn" data-action="rollSoak" data-zone="{{this.code}}">
                      <i class="fas fa-shield-halved"></i>
                    </button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <!-- Weapons List -->
        <div class="nr-card">
          <div class="nr-section-header">
            <h2 class="nr-section-title">{{localize "NORETURN.Combat.WeaponsHeader"}}</h2>
            <button type="button" class="nr-btn small" data-action="createItem" data-type="weapon">
              <i class="fas fa-plus"></i> {{localize "NORETURN.Combat.AddWeapon"}}
            </button>
          </div>

          <table class="nr-table weapons-table">
            <thead>
              <tr>
                <th>{{localize "NORETURN.Combat.WeaponName"}}</th>
                <th>{{localize "NORETURN.Skills.Pool"}}</th>
                <th>{{localize "NORETURN.Combat.Caliber"}}</th>
                <th>{{localize "NORETURN.Combat.Magazine"}}</th>
                <th>{{localize "NORETURN.Combat.AmmoLoaded"}}</th>
                <th>{{localize "NORETURN.Combat.Damage"}}</th>
                <th>{{localize "NORETURN.Combat.RD"}}</th>
                <th>{{localize "NORETURN.Combat.FireModes"}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each weapons}}
                <tr data-item-id="{{this.id}}">
                  <td>
                    <a data-action="editItem"><strong>{{this.name}}</strong></a>
                    <div class="muted" style="font-size:0.78em;">{{this.system.combatSkillInfo.canonicalLabel}}</div>
                  </td>
                  <td class="pool-cell center" data-tooltip="{{this.system.poolTooltip}}" title="{{this.system.poolTooltip}}">
                    <strong>{{this.system.attackPool}}W6</strong>
                  </td>
                  <td>{{this.system.caliber}}</td>
                  <td>
                    {{#if this.system.isRanged}}
                      <strong>{{this.system.ammoCurrent}} / {{this.system.magazineCapacity}}</strong>
                      <div class="nr-inline-controls" style="gap:3px;margin-top:3px;">
                        <button type="button" class="nr-btn small" data-action="loadWeaponAmmo" title="Munition aus Inventar laden / wechseln">
                          <i class="fas fa-rotate"></i> Laden / Wechseln
                        </button>
                        <button type="button" class="nr-btn small secondary" data-action="unloadWeaponAmmo" title="Magazin entladen (zurück ins Inventar)">
                          <i class="fas fa-eject"></i> Entladen
                        </button>
                      </div>
                    {{else}}
                      {{this.system.magazine}}
                    {{/if}}
                  </td>
                  <td>
                    {{#if this.system.isRanged}}
                      <select class="nr-weapon-ammo-select" data-weapon-id="{{this.id}}" style="max-width:190px;font-size:0.86em;">
                        <option value="unload" {{#if (and (eq this.system.ammoCurrent 0) (eq this.system.loadedAmmoId ""))}}selected{{/if}}>
                          – Nicht geladen (0/{{this.system.magazineCapacity}}) –
                        </option>
                        {{#if this.compatibleAmmoItems.length}}
                          <optgroup label="Inventar ({{this.system.caliber}})">
                            {{#each this.compatibleAmmoItems}}
                              <option value="item:{{this.id}}" {{#if (eq ../system.loadedAmmoId this.id)}}selected{{/if}}>
                                {{this.name}} [{{this.system.ammoType}}] ({{this.system.quantity}}x)
                              </option>
                            {{/each}}
                          </optgroup>
                        {{/if}}
                        <optgroup label="Munitionstyp (Manuell)">
                          {{#each ../ammoTypes}}
                            <option value="type:{{this.code}}" {{#if (and (gt ../system.ammoCurrent 0) (eq ../system.loadedAmmoId "") (eq ../system.loadedAmmoType this.code))}}selected{{/if}}>
                              {{this.code}} – {{this.effect}}
                            </option>
                          {{/each}}
                        </optgroup>
                      </select>
                    {{else}}
                      –
                    {{/if}}
                  </td>
                  <td>
                    <strong>{{this.system.effectiveDamageDisplay}}</strong>
                    {{#if this.system.damageBonusPerHit}}
                      <div class="muted" style="font-size:0.78em;">Grund: {{this.system.baseWeaponDamage}} | Kugel: +{{this.system.damageBonusPerHit}}</div>
                    {{/if}}
                  </td>
                  <td class="center">{{this.system.recoilDampening}}</td>
                  <td>{{this.system.fireModes}}</td>
                  <td class="actions-cell">
                    <button type="button" class="nr-roll-btn" data-action="rollWeapon" title="{{localize 'NORETURN.Combat.RollAttack'}}">
                      <i class="fas fa-crosshairs"></i>
                    </button>
                    <button type="button" class="nr-roll-btn" data-action="rollDamage" title="{{localize 'NORETURN.Combat.RollDamage'}}">
                      <i class="fas fa-burst"></i>
                    </button>
                    <button type="button" class="nr-icon-btn" data-action="editItem"><i class="fas fa-edit"></i></button>
                    <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <!-- Armor List -->
        <div class="nr-card">
          <div class="nr-section-header">
            <h2 class="nr-section-title">{{localize "NORETURN.Combat.ArmorHeader"}}</h2>
            <button type="button" class="nr-btn small" data-action="createItem" data-type="armor">
              <i class="fas fa-plus"></i> {{localize "NORETURN.Combat.AddArmor"}}
            </button>
          </div>

          <table class="nr-table armor-table">
            <thead>
              <tr>
                <th>{{localize "NORETURN.Combat.Equipped"}}</th>
                <th>{{localize "TYPES.Item.armor"}}</th>
                <th>{{localize "NORETURN.Health.Armor"}}</th>
                <th>{{localize "NORETURN.Health.MaterialCategory"}}</th>
                <th>{{localize "NORETURN.Health.Zone"}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each armors}}
                <tr data-item-id="{{this.id}}">
                  <td class="center">
                    <input type="checkbox" data-action="toggleEquipped" {{checked this.system.equipped}} />
                  </td>
                  <td><a data-action="editItem"><strong>{{this.name}}</strong></a></td>
                  <td class="center">{{this.system.armorValue}}</td>
                  <td class="center">{{this.system.materialCategory}}</td>
                  <td>
                    {{#if this.system.isSelectableZone}}
                      <select class="nr-armor-single-zone-select" data-item-id="{{this.id}}" data-action="changeArmorZone" title="Einzelzone für diese Panzerung wählen">
                        {{#each ../selectableArmorZones}}
                          <option value="{{this.num}}" {{#if (or (eq ../this.system.selectedZone this.num) (eq ../this.system.coveredZones.[0] this.num))}}selected{{/if}}>
                            {{this.label}}
                          </option>
                        {{/each}}
                      </select>
                    {{else}}
                      <span title="{{this.system.zonesLabel}}">{{this.system.zonesLabel}}</span>
                    {{/if}}
                  </td>
                  <td class="actions-cell">
                    <button type="button" class="nr-icon-btn" data-action="editItem"><i class="fas fa-edit"></i></button>
                    <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    {{/if}}

    <!-- TAB 5: INVENTORY, DRUGS & GEAR -->
    {{#if (eq activeTab "inventory")}}
      <div class="tab-panel active">
        <!-- Drugs & Pharmaceuticals (Consumables) -->
        <div class="nr-card">
          <div class="nr-section-header">
            <h2 class="nr-section-title">{{localize "NORETURN.Consumables.Header"}}</h2>
            <button type="button" class="nr-btn small" data-action="createItem" data-type="consumable">
              <i class="fas fa-plus"></i> {{localize "NORETURN.Consumables.AddConsumable"}}
            </button>
          </div>

          <table class="nr-table consumables-table">
            <thead>
              <tr>
                <th>{{localize "NORETURN.Consumables.Active"}}</th>
                <th>{{localize "TYPES.Item.consumable"}}</th>
                <th>{{localize "NORETURN.Consumables.Dosage"}}</th>
                <th>{{localize "NORETURN.Consumables.Duration"}}</th>
                <th>{{localize "NORETURN.Consumables.Addiction"}}</th>
                <th>{{localize "NORETURN.Consumables.BoostsDrawbacks"}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each consumables}}
                <tr data-item-id="{{this.id}}">
                  <td class="center">
                    <input type="checkbox" data-action="toggleActive" {{checked this.system.active}} />
                  </td>
                  <td><a data-action="editItem"><strong>{{this.name}}</strong></a> ({{this.system.quantity}}x)</td>
                  <td>{{this.system.dosage}}</td>
                  <td>{{this.system.duration}}</td>
                  <td>{{this.system.addictionRating}}</td>
                  <td>{{this.system.statBoosts}} {{#if this.system.drawbacks}}| {{this.system.drawbacks}}{{/if}}</td>
                  <td class="actions-cell">
                    <button type="button" class="nr-icon-btn" data-action="editItem"><i class="fas fa-edit"></i></button>
                    <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <!-- Ammunition & Projectiles -->
        <div class="nr-card">
          <div class="nr-section-header">
            <h2 class="nr-section-title">{{localize "NORETURN.Inventory.AmmoHeader"}}</h2>
            <button type="button" class="nr-btn small" data-action="createItem" data-type="ammo">
              <i class="fas fa-plus"></i> {{localize "NORETURN.Inventory.AddAmmo"}}
            </button>
          </div>

          <table class="nr-table ammo-table">
            <thead>
              <tr>
                <th>{{localize "TYPES.Item.ammo"}}</th>
                <th>{{localize "NORETURN.Combat.Caliber"}}</th>
                <th>Typ</th>
                <th>{{localize "NORETURN.Inventory.Quantity"}}</th>
                <th>{{localize "NORETURN.Inventory.Price"}}</th>
                <th>{{localize "NORETURN.Inventory.Effects"}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each ammoItems}}
                <tr data-item-id="{{this.id}}">
                  <td>
                    <a data-action="editItem" style="display:inline-flex;align-items:center;gap:6px;">
                      <img src="systems/noreturn/assets/icons/ammo.svg" width="20" height="20" style="border:none;vertical-align:middle;" />
                      <strong>{{this.name}}</strong>
                    </a>
                  </td>
                  <td class="center">{{this.system.caliber}}</td>
                  <td class="center"><strong>{{this.system.ammoType}}</strong></td>
                  <td class="center"><strong>{{this.system.quantity}}</strong></td>
                  <td class="center">{{this.system.price}} N$</td>
                  <td>{{this.system.effects}}</td>
                  <td class="actions-cell">
                    <button type="button" class="nr-icon-btn" data-action="editItem"><i class="fas fa-edit"></i></button>
                    <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <!-- Standard Gear -->
        <div class="nr-card">
          <div class="nr-section-header">
            <h2 class="nr-section-title">{{localize "NORETURN.Inventory.GearHeader"}}</h2>
            <button type="button" class="nr-btn small" data-action="createItem" data-type="gear">
              <i class="fas fa-plus"></i> {{localize "NORETURN.Inventory.AddGear"}}
            </button>
          </div>

          <table class="nr-table gear-table">
            <thead>
              <tr>
                <th>{{localize "TYPES.Item.gear"}}</th>
                <th>{{localize "NORETURN.Inventory.Quantity"}}</th>
                <th>{{localize "NORETURN.Inventory.Price"}}</th>
                <th>{{localize "NORETURN.Inventory.TechLevel"}}</th>
                <th>{{localize "NORETURN.Inventory.Effects"}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each gear}}
                <tr data-item-id="{{this.id}}">
                  <td><a data-action="editItem"><strong>{{this.name}}</strong></a></td>
                  <td class="center">{{this.system.quantity}}</td>
                  <td class="center">{{this.system.price}} N$</td>
                  <td class="center">{{this.system.techLevel}}</td>
                  <td>{{this.system.effects}}</td>
                  <td class="actions-cell">
                    <button type="button" class="nr-icon-btn" data-action="editItem"><i class="fas fa-edit"></i></button>
                    <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    {{/if}}

    <!-- TAB 6: AUGMENTATION / CYBERWARE -->
    {{#if (eq activeTab "augmentation")}}
      <div class="tab-panel active">
        <div class="nr-card">
          <div class="nr-section-header">
            <h2 class="nr-section-title">{{localize "NORETURN.Inventory.CyberwareHeader"}}</h2>
            <div class="nr-inline-controls">
              <span class="nr-badge-stat {{#if isOrganismCritical}}danger{{/if}}">
                {{localize "NORETURN.Status.CyberwareCost"}}: <strong>-{{system.status.organismus.cyberwareCost}}</strong> |
                {{localize "NORETURN.Status.Organismus"}}: <strong>{{system.status.organismus.current}} / {{system.status.organismus.max}}</strong>
              </span>
              <button type="button" class="nr-btn small" data-action="createItem" data-type="cyberware">
                <i class="fas fa-plus"></i> {{localize "NORETURN.Inventory.AddCyberware"}}
              </button>
            </div>
          </div>

          <table class="nr-table cyberware-table">
            <thead>
              <tr>
                <th>{{localize "NORETURN.Inventory.Installed"}}</th>
                <th>{{localize "TYPES.Item.cyberware"}}</th>
                <th>{{localize "NORETURN.Health.Zone"}}</th>
                <th>{{localize "NORETURN.Status.Organismus"}}</th>
                <th>{{localize "NORETURN.Robotics.Capacity"}}</th>
                <th>{{localize "NORETURN.Inventory.Effects"}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each augmentations}}
                <tr data-item-id="{{this.id}}">
                  <td class="center">
                    <input type="checkbox" data-action="toggleInstalled" {{checked this.system.installed}} />
                  </td>
                  <td><a data-action="editItem"><strong>{{this.name}}</strong></a></td>
                  <td>{{this.system.zone}}</td>
                  <td class="center">-{{this.system.organismCost}}</td>
                  <td class="center">{{this.system.capacityCost}}</td>
                  <td>{{this.system.effects}}</td>
                  <td class="actions-cell">
                    <button type="button" class="nr-icon-btn" data-action="editItem"><i class="fas fa-edit"></i></button>
                    <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    {{/if}}

    <!-- TAB 7: SPECIES, MUTATIONS, TRAITS & NOTES -->
    {{#if (eq activeTab "bio")}}
      <div class="tab-panel active">
        <!-- Active Species Item & Mutations / Abnormalities -->
        <div class="nr-card">
          <div class="nr-section-header">
            <h2 class="nr-section-title">{{localize "NORETURN.Species.MutationsHeader"}}</h2>
            <div class="nr-inline-controls">
              <button type="button" class="nr-btn small" data-action="createItem" data-type="species">
                <i class="fas fa-dna"></i> {{localize "NORETURN.Species.AddSpecies"}}
              </button>
              <button type="button" class="nr-btn small" data-action="createItem" data-type="mutation">
                <i class="fas fa-plus"></i> {{localize "NORETURN.Species.AddMutation"}}
              </button>
            </div>
          </div>

          {{#if speciesItems.length}}
            <table class="nr-table species-table">
              <thead>
                <tr>
                  <th>{{localize "TYPES.Item.species"}}</th>
                  <th>{{localize "NORETURN.Species.Subspecies"}}</th>
                  <th>{{localize "NORETURN.Species.CostGp"}}</th>
                  <th>{{localize "NORETURN.Species.Legality"}}</th>
                  <th>{{localize "NORETURN.Species.SpecialRules"}}</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {{#each speciesItems}}
                  <tr data-item-id="{{this.id}}">
                    <td><a data-action="editItem"><strong>{{this.name}}</strong></a></td>
                    <td>{{this.system.subspecies}}</td>
                    <td class="center">{{this.system.costGp}} GP</td>
                    <td>{{this.system.legality}}</td>
                    <td>{{this.system.specialRules}}</td>
                    <td class="actions-cell">
                      <button type="button" class="nr-icon-btn" data-action="editItem"><i class="fas fa-edit"></i></button>
                      <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          {{/if}}

          <table class="nr-table mutations-table">
            <thead>
              <tr>
                <th>{{localize "NORETURN.Consumables.Active"}}</th>
                <th>{{localize "TYPES.Item.mutation"}}</th>
                <th>{{localize "NORETURN.Skills.Category"}}</th>
                <th>{{localize "NORETURN.Skills.Level"}}</th>
                <th>{{localize "NORETURN.Species.CostMpGp"}}</th>
                <th>{{localize "NORETURN.Inventory.Effects"}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each mutations}}
                <tr data-item-id="{{this.id}}">
                  <td class="center">
                    <input type="checkbox" data-action="toggleActive" {{checked this.system.active}} />
                  </td>
                  <td><a data-action="editItem"><strong>{{this.name}}</strong></a></td>
                  <td>{{this.system.category}}</td>
                  <td class="center">{{this.system.level}} / {{this.system.maxLevel}}</td>
                  <td class="center">
                    {{#if this.system.costGp}}{{this.system.costGp}} GP{{else}}{{this.system.costMp}} MP{{/if}}
                  </td>
                  <td>{{this.system.effects}}</td>
                  <td class="actions-cell">
                    <button type="button" class="nr-icon-btn" data-action="editItem"><i class="fas fa-edit"></i></button>
                    <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <!-- Character Traits (Justice / Chaos / Perks) -->
        <div class="nr-card">
          <div class="nr-section-header">
            <h2 class="nr-section-title">{{localize "NORETURN.Traits.Charaktermerkmale"}}</h2>
            <button type="button" class="nr-btn small" data-action="createItem" data-type="trait">
              <i class="fas fa-plus"></i> {{localize "NORETURN.Traits.AddTrait"}}
            </button>
          </div>

          <table class="nr-table traits-table">
            <thead>
              <tr>
                <th>{{localize "TYPES.Item.trait"}}</th>
                <th>{{localize "NORETURN.Skills.Category"}}</th>
                <th>{{localize "NORETURN.Traits.Cost"}}</th>
                <th>{{localize "NORETURN.Traits.PassiveModifiers"}}</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {{#each traits}}
                <tr data-item-id="{{this.id}}">
                  <td><a data-action="editItem"><strong>{{this.name}}</strong></a></td>
                  <td>{{this.system.traitType}}</td>
                  <td class="center">{{this.system.cost}} {{this.system.costCurrency}}</td>
                  <td>{{this.system.passiveModifiers}}</td>
                  <td class="actions-cell">
                    <button type="button" class="nr-icon-btn" data-action="editItem"><i class="fas fa-edit"></i></button>
                    <button type="button" class="nr-icon-btn danger" data-action="deleteItem"><i class="fas fa-trash"></i></button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <div class="nr-card">
          <h2 class="nr-section-title">{{localize "NORETURN.Sheet.Tabs.Bio"}}</h2>
          <div class="nr-stat-grid">
            <label>
              <span>{{localize "NORETURN.Traits.Charaktermerkmale"}}</span>
              <input type="text" name="system.traits.charaktermerkmale" value="{{system.traits.charaktermerkmale}}" />
            </label>
            <label>
              <span>{{localize "NORETURN.Traits.Mutationen"}}</span>
              <input type="text" name="system.traits.mutationen" value="{{system.traits.mutationen}}" />
            </label>
            <label>
              <span>{{localize "NORETURN.Traits.Begabungen"}}</span>
              <input type="text" name="system.traits.begabungen" value="{{system.traits.begabungen}}" />
            </label>
            <label>
              <span>{{localize "NORETURN.Traits.Talente"}}</span>
              <input type="text" name="system.traits.talente" value="{{system.traits.talente}}" />
            </label>
            <label>
              <span>{{localize "NORETURN.Traits.StyleSkills"}}</span>
              <input type="text" name="system.traits.styleSkills" value="{{system.traits.styleSkills}}" />
            </label>
            <label>
              <span>{{localize "NORETURN.Traits.Kampfsportarten"}}</span>
              <input type="text" name="system.traits.kampfsportarten" value="{{system.traits.kampfsportarten}}" />
            </label>
          </div>

          <h3 class="nr-subtitle">{{localize "NORETURN.Traits.Notes"}}</h3>
          <textarea class="nr-notes-area" name="system.notes" rows="8">{{system.notes}}</textarea>
        </div>
      </div>
    {{/if}}
  </section>
</div>
